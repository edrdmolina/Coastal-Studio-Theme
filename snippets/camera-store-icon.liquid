{% comment %}Small, decorative icons for the camera storefront.{% endcomment %}
<svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
  {% case icon %}
    {% when 'arrow' %}<path d="M4 12h16m-6-6 6 6-6 6"/>
    {% when 'shield' %}<path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6l8-3Z"/><path d="m8 12 3 3 5-6"/>
    {% when 'camera' %}<path d="M3 7h4l2-3h6l2 3h4v13H3Z"/><circle cx="12" cy="13" r="4"/>
    {% when 'box' %}<path d="m3 7 9-4 9 4v10l-9 4-9-4V7Zm0 0 9 4 9-4M12 11v10M7 5l10 4"/>
    {% when 'search' %}<circle cx="10" cy="10" r="6"/><path d="m15 15 6 6"/>
    {% when 'check' %}<path d="m5 12 4 4L19 6"/>
    {% when 'plus' %}<path d="M12 5v14M5 12h14"/>
  {% endcase %}
</svg>
