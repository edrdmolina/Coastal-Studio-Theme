{%- comment -%}
  Shared card/filter condition: grade|special. Only explicit condition data or
  listing language is used; availability never implies working condition.
{%- endcomment -%}
{%- liquid
  assign title_text = product.title | downcase
  assign description_text = product.description | strip_html | replace: '&nbsp;', ' ' | replace: '&#160;', ' ' | replace: '&#xA0;', ' ' | replace: ' ', ' ' | downcase
  assign grade = product.metafields.custom.condition.value | default: '' | replace: ' ', ' ' | strip
  if grade == blank and description_text contains 'condition:'
    assign condition_text = description_text | split: 'condition:' | last | strip
    assign first_three = condition_text | slice: 0, 3
    assign first_four = condition_text | slice: 0, 4
    assign first_five = condition_text | slice: 0, 5
    assign first_seven = condition_text | slice: 0, 7
    assign first_nine = condition_text | slice: 0, 9
    if first_nine == 'near mint'
      assign grade = 'Near mint'
    elsif first_three == 'new'
      assign grade = 'New'
    elsif first_four == 'mint'
      assign grade = 'Mint'
    elsif first_nine == 'excellent'
      assign grade = 'Excellent'
    elsif first_four == 'good'
      assign grade = 'Good'
    elsif first_seven == 'one-off' or first_seven == 'one off'
      assign grade = 'One-Off'
    elsif first_five == 'as-is' or first_five == 'as is'
      assign grade = 'AS-IS'
    endif
  endif
  assign normalized_grade = grade | downcase | replace: ' ', '-'
  assign special_item = false
  if normalized_grade == 'as-is' or normalized_grade contains 'display'
    assign special_item = true
  endif
  if title_text contains 'display' or title_text contains 'shelf piece' or title_text contains 'as is' or title_text contains 'as-is'
    assign special_item = true
  endif
  if description_text contains 'for display only' or description_text contains 'display-only'
    assign special_item = true
  endif
  if normalized_grade == 'as-is'
    assign grade = 'AS-IS'
  endif
-%}
{{- grade | replace: '|', '/' -}}|{{- special_item -}}
