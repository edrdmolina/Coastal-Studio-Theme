{% comment %}
  LocalBusiness structured data.

  The theme already emits Organization and WebSite from header.liquid, but
  neither carries an address, so nothing on the site tells Google there is a
  physical lab in Tampa. That is the schema that feeds the map pack and the
  "near me" results a walk-in customer actually searches, and for a business
  whose whole local pitch is a drop box you can reach at any hour, it is the
  single most valuable piece of markup missing.

  Values come from the shop drop wherever Shopify exposes them, so an address
  or phone change in the admin propagates here without a code edit.

  OPENING HOURS are the hours the counter is open to the public, which is not
  the same as the days the lab runs. We develop film daily and work Wednesdays;
  the shop simply is not open to walk-ins that day. Only public hours belong in
  this markup — Google prints them as "Open / Closed" next to the listing, and
  publishing a working day as an open day sends someone to a locked door.

  Closed days (Sunday, Wednesday) are omitted rather than written as 00:00-00:00.
  Omission is how schema.org expresses closed, and the explicit-zero form is
  read by some parsers as open around the clock.

  Usage (once, in the head):
    {% render 'cfl-local-business' %}
{% endcomment %}

{%- liquid

  comment
    Shopify Liquid has no array push filter, so the social list is assembled as
    a delimited string and split. A tilde is the delimiter because it cannot
    appear in a URL without being percent-encoded first.
  endcomment
  assign social_raw = ''
  if settings.social_instagram_link != blank
    assign social_raw = social_raw | append: settings.social_instagram_link | append: '~'
  endif
  if settings.social_facebook_link != blank
    assign social_raw = social_raw | append: settings.social_facebook_link | append: '~'
  endif
  if settings.social_youtube_link != blank
    assign social_raw = social_raw | append: settings.social_youtube_link | append: '~'
  endif
  if settings.social_tiktok_link != blank
    assign social_raw = social_raw | append: settings.social_tiktok_link | append: '~'
  endif
  assign socials = social_raw | split: '~'

  comment
    The shop drop has no latitude or longitude, so these come from the store's
    own location record in the admin. They only change if the lab moves.
  endcomment
  assign lat = 27.9597954
  assign lng = -82.4514203
-%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": {{ shop.url | append: '/#localbusiness' | json }},
  "name": {{ shop.name | json }},
  "url": {{ shop.url | json }},
  "description": {{ shop.description | strip_html | strip | json }},
  {%- if settings.logo %}
    "image": {{ settings.logo | image_url: width: 1000 | prepend: "https:" | json }},
    "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
  {%- endif %}
  {%- if shop.phone != blank %}
    "telephone": {{ shop.phone | json }},
  {%- endif %}
  {%- if shop.email != blank %}
    "email": {{ shop.email | json }},
  {%- endif %}
  "address": {
    "@type": "PostalAddress",
    "streetAddress": {{ shop.address.address1 | json }},
    "addressLocality": {{ shop.address.city | json }},
    "addressRegion": {{ shop.address.province_code | json }},
    "postalCode": {{ shop.address.zip | json }},
    "addressCountry": "US"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": {{ lat }},
    "longitude": {{ lng }}
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Thursday", "Friday"],
      "opens": "10:00",
      "closes": "18:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": "Saturday",
      "opens": "10:00",
      "closes": "15:00"
    }
  ],
  "priceRange": "$$",
  "areaServed": [
    { "@type": "City", "name": "Tampa" },
    { "@type": "Country", "name": "United States" }
  ],
  "sameAs": [
    {%- for s in socials -%}
      {{ s | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
