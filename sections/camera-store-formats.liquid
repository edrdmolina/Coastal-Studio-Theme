{{ 'camera-store.css' | asset_url | stylesheet_tag }}
<div class="camera-store cs-formats"><div class="cs-shell">
    <div class="cs-section-heading cs-category-heading">
      <div><p class="cs-eyebrow">FIND YOUR FORMAT</p><h2>{{ section.settings.category_heading | escape }}</h2></div>
      <p>Different ways to see.<br>The same love for film.</p>
    </div>
    <div class="cs-categories">
      {% for block in section.blocks %}
        {% assign category = block.settings.collection %}
        {% if category != blank %}
          <a class="cs-category" href="{{ category.url }}" {{ block.shopify_attributes }}>
            <div class="cs-category__image">
              {% assign category_image = block.settings.image | default: category.featured_image %}
              {% if category_image != blank %}
                {{ category_image | image_url: width: 640 | image_tag: widths: '240, 400, 640', sizes: '(min-width: 990px) 20vw, (min-width: 600px) 33vw, 50vw', loading: 'lazy', alt: category.title }}
              {% endif %}
              <span class="cs-category__number">0{{ forloop.index }}</span>
            </div>
            <div class="cs-category__title"><h3>{{ block.settings.heading | default: category.title | escape }}</h3>{% render 'camera-store-icon', icon: 'arrow' %}</div>
            <p>{{ block.settings.description | escape }}</p>
          </a>
        {% endif %}
      {% endfor %}
    </div>
</div></div>
{% schema %}
{"name":"Camera store: formats","settings":[{"type":"text","id":"category_heading","label":"Heading","default":"What kind of photographer are you?"}],"blocks":[{"type":"category","name":"Camera category","limit":5,"settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"image_picker","id":"image","label":"Image override"},{"type":"text","id":"heading","label":"Heading"},{"type":"text","id":"description","label":"Short description"}]}],"presets":[{"name":"Camera store: formats"}]}
{% endschema %}
