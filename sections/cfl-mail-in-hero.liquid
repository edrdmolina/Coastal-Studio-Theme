{% comment %}
  First screen of /pages/mail-your-film, the Instagram landing page for
  mail-in film processing.

  Left column: the offer, the live turnaround line and the Google rating.
  Right column (below on phones): one card per film format. The cards are the
  page's main action. Each links through /discount/CODE?redirect=…, which
  stores the code on the visitor's cart session and then opens the product, so
  the discount is already applied when they reach checkout.

  The turnaround line is the Twin Check'n "Turnaround Times" app block (Layout:
  Sentence). Add it to this section in the theme editor; it renders between the
  offer and the rating. The number is fetched live on each visit, so nothing
  here needs updating by hand.

  Prices come from the products, so a price change in the admin shows here
  without a theme edit. A format block can point at a collection instead of a
  product (used for "110, APS and more"); it then shows its "Price text".

  The site menu and search are hidden on this template (logo, account and
  cart stay), so a visitor from Instagram has one job on the page. The footer
  still carries the full set of links.

  Mouseflow (heatmaps) loads only when a website ID is set below, and so only
  on templates that use this section.
{% endcomment %}

{{ 'cfl-mail-in.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {%- if section.settings.hide_menu -%}
    .header header-drawer,
    .header .header__inline-menu,
    .header .header__search {
      display: none;
    }

    /*
      Phones: with the drawer gone, its empty grid column pushed the logo in
      and the theme hides the account icon below 750px (it normally lives in
      the drawer). Logo left, account and cart right, 44px targets.
    */
    @media screen and (max-width: 749px) {
      .header-wrapper .header {
        grid-template-areas: 'heading icons';
        grid-template-columns: minmax(0, 1fr) auto;
        padding: 10px 12px 10px 20px;
      }

      .header-wrapper .header__heading-link {
        margin: 0;
        padding: 0;
      }

      .header-wrapper .header__heading-logo {
        width: auto;
        height: 36px;
      }

      .header-wrapper .header__icons .header__icon,
      .header-wrapper .header__icon--cart .icon {
        width: 44px;
        height: 44px;
      }

      .header-wrapper .header__icon--account {
        display: flex !important;
      }
    }
  {%- endif -%}

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign code = section.settings.discount_code | strip
  assign code_encoded = code | url_encode
-%}

<div class="cfl-mail color-{{ section.settings.color_scheme }} gradient">
  <div class="cfl-mail__hero page-width section-{{ section.id }}-padding">
    <div class="cfl-mail__intro">
      {%- if section.settings.tag != blank -%}
        <p class="cfl-mail__tag">{{ section.settings.tag }}</p>
      {%- endif -%}

      <h1 class="cfl-mail__title">{{ section.settings.heading }}</h1>

      {%- if section.settings.offer != blank -%}
        <p class="cfl-mail__offer">{{ section.settings.offer }}</p>
      {%- endif -%}

      {%- if code != blank and section.settings.code_note != blank -%}
        <p class="cfl-mail__note">
          {{- section.settings.code_note | replace: '[code]', '<span class="cfl-mail__code">[code]</span>' | replace: '[code]', code -}}
        </p>
      {%- endif -%}

      <div class="cfl-mail__facts">
        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}
            <div class="cfl-mail__fact cfl-mail__fact--app" {{ block.shopify_attributes }}>
              {% render block %}
            </div>
          {%- endif -%}
        {%- endfor -%}

        {%- if section.settings.rating != blank -%}
          <p class="cfl-mail__fact">
            <svg class="cfl-mail__star" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12 2l3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z"/>
            </svg>
            {%- if section.settings.reviews_url != blank -%}
              <a href="{{ section.settings.reviews_url }}" target="_blank" rel="noopener">
                {{- section.settings.rating }} from {{ section.settings.review_count }} Google reviews
                <span class="visually-hidden">(opens in a new tab)</span>
              </a>
            {%- else -%}
              <span>{{ section.settings.rating }} from {{ section.settings.review_count }} Google reviews</span>
            {%- endif -%}
          </p>
        {%- endif -%}
      </div>
    </div>

    <div class="cfl-mail__picker" id="film">
      {%- if section.settings.cards_heading != blank -%}
        <h2 class="cfl-mail__picker-title">{{ section.settings.cards_heading }}</h2>
      {%- endif -%}

      <ul class="cfl-mail__cards" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type != 'format' -%}{%- continue -%}{%- endif -%}
          {%- liquid
            assign card_product = block.settings.product
            assign target = blank
            assign price_text = block.settings.price_text

            if card_product != blank
              assign target = card_product.url
              if price_text == blank
                assign price_text = card_product.price | money_without_trailing_zeros
              endif
            elsif block.settings.link != blank
              assign target = block.settings.link
            endif

            if target == blank
              continue
            endif

            if code != blank
              assign target_encoded = target | url_encode
              assign href = '/discount/' | append: code_encoded | append: '?redirect=' | append: target_encoded
            else
              assign href = target
            endif

            assign label = block.settings.label
            if label == blank and card_product != blank
              assign label = card_product.title
            endif
          -%}
          <li {{ block.shopify_attributes }}>
            <a class="cfl-mail__card" href="{{ href }}">
              <span class="cfl-mail__card-label">{{ label }}</span>
              {%- if price_text != blank -%}
                <span class="cfl-mail__card-price">{{ price_text }}</span>
              {%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ul>

      {%- if section.settings.cards_note != blank -%}
        <p class="cfl-mail__note">{{ section.settings.cards_note }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

{%- comment -%}
  Apply the code as soon as someone lands, so it is on their cart however they
  reach a product (format card, footer link, coming back later). The format
  card links apply it as well, so this is a backstop, not the only path.
  /discount/CODE stores the code on the cart; redirecting to /cart.js keeps the
  response small. Shopify only takes it off at checkout if the order is under
  the minimum or the customer has ordered processing before.
{%- endcomment -%}
{%- if code != blank and request.design_mode == false -%}
  <script>
    (function () {
      var KEY = 'cfl-mail-code-applied';
      try {
        if (window.sessionStorage.getItem(KEY) === '1') return;
      } catch (e) {}
      fetch('/discount/{{ code_encoded }}?redirect=%2Fcart.js', { credentials: 'same-origin' })
        .then(function (res) {
          if (!res.ok) return;
          try {
            window.sessionStorage.setItem(KEY, '1');
          } catch (e) {}
        })
        .catch(function () {});
    })();
  </script>
{%- endif -%}

{%- assign mouseflow_id = section.settings.mouseflow_id | strip -%}
{%- if mouseflow_id != blank and request.design_mode == false -%}
  <script>
    window._mfq = window._mfq || [];
    (function () {
      var mf = document.createElement('script');
      mf.defer = true;
      mf.src = 'https://cdn.mouseflow.com/projects/{{ mouseflow_id | url_encode }}.js';
      document.head.appendChild(mf);
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Mail-in landing: hero",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Tag above heading",
      "default": "New customers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Mail us your film. Your first roll is on us."
    },
    {
      "type": "text",
      "id": "offer",
      "label": "Offer",
      "default": "$20 off your first order of $50 or more. Shipping not included."
    },
    {
      "type": "text",
      "id": "discount_code",
      "label": "Discount code",
      "info": "Applied automatically by every format card. Leave empty to link straight to the products.",
      "default": "FIRSTROLLFREE"
    },
    {
      "type": "text",
      "id": "code_note",
      "label": "Code note",
      "info": "[code] is replaced by the discount code.",
      "default": "Code [code] is added for you when you pick your film."
    },
    {
      "type": "header",
      "content": "Google rating"
    },
    {
      "type": "text",
      "id": "rating",
      "label": "Rating",
      "info": "Copy from the Google profile monthly. Leave empty to hide.",
      "default": "4.9"
    },
    {
      "type": "number",
      "id": "review_count",
      "label": "Number of reviews",
      "default": 182
    },
    {
      "type": "url",
      "id": "reviews_url",
      "label": "Google profile link"
    },
    {
      "type": "header",
      "content": "Format cards"
    },
    {
      "type": "text",
      "id": "cards_heading",
      "label": "Heading",
      "default": "What are you sending?"
    },
    {
      "type": "text",
      "id": "cards_note",
      "label": "Note under the cards",
      "default": "Per roll, developed and scanned. Any three rolls reach the $50 minimum."
    },
    {
      "type": "header",
      "content": "Page"
    },
    {
      "type": "checkbox",
      "id": "hide_menu",
      "label": "Hide the site menu and search",
      "info": "Logo, account and cart stay. The footer keeps every link.",
      "default": true
    },
    {
      "type": "text",
      "id": "mouseflow_id",
      "label": "Mouseflow website ID",
      "info": "Loads Mouseflow heatmaps on this page only. Leave empty to turn it off."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "accent-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "format",
      "name": "Format card",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "info": "Defaults to the product title."
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "The card shows this product's price."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link instead of a product",
          "info": "Used only when no product is chosen, e.g. a collection."
        },
        {
          "type": "text",
          "id": "price_text",
          "label": "Price text",
          "info": "Overrides the product price, e.g. From $22."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mail-in landing: hero"
    }
  ]
}
{% endschema %}
