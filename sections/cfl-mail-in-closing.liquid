{% comment %}
  Closing pitch on /pages/mail-your-film: a dark panel that sends the visitor
  back up to the format cards (#film in cfl-mail-in-hero), where the discount
  code is applied.
{% endcomment %}

{{ 'cfl-mail-in.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="page-width section-{{ section.id }}-padding">
  <div class="cfl-mail__closing">
    <h2 class="cfl-mail__closing-title">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}
      <p class="cfl-mail__closing-text">{{ section.settings.text }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="cfl-mail__button" href="{{ section.settings.button_link | default: '#film' }}">
        {{- section.settings.button_label -}}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Mail-in landing: closing",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Got a few rolls lying around?"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Send three and take $20 off your first order."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Start your order"
    },
    {
      "type": "text",
      "id": "button_link",
      "label": "Button link",
      "info": "#film scrolls to the format cards.",
      "default": "#film"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Mail-in landing: closing"
    }
  ]
}
{% endschema %}
