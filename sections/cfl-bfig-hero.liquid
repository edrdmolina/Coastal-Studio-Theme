{% comment %}
  First screen of /pages/black-friday, the Black Friday 2026 sale page. The
  same page is the Instagram bio link and story link sticker target. Template
  page.black-friday. Modelled on the mail-in landing hero (cfl-mail-in-hero).

  Phone: offer and both paths fit on a 390x844 screen without scrolling.
  From 750px a row of sale facts appears, and from 990px the right-hand
  column shows a photo in the 35mm film frame from the home page hero
  (cfl-hero): the same .cfl-hero__film class from cfl-components.css, which
  theme.liquid loads on every page.

  Two paths, both visible on a 390x844 phone without scrolling: develop film
  (10% off) and gear $299.99 and up (15% off). Both discounts are automatic, so
  the links go straight to the collections. No discount code is applied.

  Sale phases. The window is fixed:
    starts  Fri Nov 27 2026, 12:00 AM ET  = 1795755600 (UTC epoch)
    ends    Tue Dec 1 2026,   9:00 AM ET  = 1796133600 (UTC epoch)
  Both dates fall in EST (UTC-5). The same two numbers appear in every
  cfl-bfig section that changes with the sale; keep them in step.

    before  "Starts Friday 12 AM": the develop card explains the timing
            instead of opening the order flow at full price; gear can be
            browsed.
    live    both paths link to their collections.
    ended   a short "sale has ended" note and a normal development button.

  Liquid picks the phase when the page is rendered. Shopify can serve that
  HTML from cache for a while, so a small script re-checks the phase in the
  browser and swaps every [data-bfig-when] element on the page. It only ever
  moves the phase forward (before -> live -> ended), so a visitor whose clock
  is behind never sees an earlier phase than the server rendered. Copy for
  later phases is in the HTML with the hidden attribute so it can be shown
  without a reload; copy for phases already over is left out.

  The site menu and search are hidden on this template, as on the mail-in
  page: logo, account and cart stay, and the footer keeps every link.
{% endcomment %}

{{ 'cfl-bfig.css' | asset_url | stylesheet_tag }}

{%- liquid
  # Sale window (see the comment at the top).
  assign bfig_start = 1795755600
  assign bfig_end = 1796133600
  assign bfig_now = 'now' | date: '%s' | plus: 0

  assign real_index = 1
  if bfig_now < bfig_start
    assign real_index = 0
  elsif bfig_now >= bfig_end
    assign real_index = 2
  endif

  assign phase_index = real_index
  assign forced = false
  if request.design_mode and section.settings.preview_phase != 'auto'
    assign forced = true
    case section.settings.preview_phase
      when 'before'
        assign phase_index = 0
      when 'live'
        assign phase_index = 1
      when 'ended'
        assign phase_index = 2
    endcase
    assign real_index = 0
  endif

  assign phases = 'before,live,ended' | split: ','
  assign phase = phases[phase_index]
-%}

{%- style -%}
  {%- if section.settings.hide_menu -%}
    .header header-drawer,
    .header .header__inline-menu,
    .header .header__search {
      display: none;
    }

    /* Same header fix as the mail-in page: logo left, account and cart right, 44px targets. */
    @media screen and (max-width: 749px) {
      .header-wrapper .header {
        grid-template-areas: 'heading icons';
        grid-template-columns: minmax(0, 1fr) auto;
        padding: 10px 12px 10px 20px;
      }

      .header-wrapper .header__heading-link {
        margin: 0;
        padding: 0;
      }

      .header-wrapper .header__heading-logo {
        width: auto;
        height: 36px;
      }

      .header-wrapper .header__icons .header__icon,
      .header-wrapper .header__icon--cart .icon {
        width: 44px;
        height: 44px;
      }

      .header-wrapper .header__icon--account {
        display: flex !important;
      }
    }
  {%- endif -%}

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- capture arrow -%}
  <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
{%- endcapture -%}

<div
  class="bfig color-{{ section.settings.color_scheme }} gradient"
  data-bfig-clock
  data-start="{{ bfig_start }}"
  data-end="{{ bfig_end }}"
  data-phase="{{ phase }}"
  data-forced="{{ forced }}"
>
  {%- comment -%} Before and during the sale: offer and two paths. {%- endcomment -%}
  {%- if real_index <= 1 -%}
    <div
      class="bfig-hero__inner page-width section-{{ section.id }}-padding"
      data-bfig-when="before live"
      {% if phase == 'ended' %}
        hidden
      {% endif %}
    >
      <div class="bfig-hero__main">
      <div class="bfig-hero__intro">
        {%- if real_index == 0 and section.settings.tag_before != blank -%}
          <p
            class="bfig-tag"
            data-bfig-when="before"
            {% unless phase == 'before' %}
              hidden
            {% endunless %}
          >
            {{ section.settings.tag_before }}
          </p>
        {%- endif -%}
        {%- if section.settings.tag_live != blank -%}
          <p
            class="bfig-tag"
            data-bfig-when="live"
            {% unless phase == 'live' %}
              hidden
            {% endunless %}
          >
            {{ section.settings.tag_live }}
          </p>
        {%- endif -%}

        <h1 class="bfig-hero__title">{{ section.settings.heading }}</h1>

        {%- if real_index == 0 -%}
          <p
            class="bfig-lead"
            data-bfig-when="before"
            {% unless phase == 'before' %}
              hidden
            {% endunless %}
          >
            {{ section.settings.text_before }}
          </p>
        {%- endif -%}
        <p
          class="bfig-lead"
          data-bfig-when="live"
          {% unless phase == 'live' %}
            hidden
          {% endunless %}
        >
          {{ section.settings.text_live }}
        </p>

        {%- capture facts -%}
          {%- for i in (1..3) -%}
            {%- assign fact_key = 'fact_' | append: i -%}
            {%- if section.settings[fact_key] != blank -%}
              <li class="bfig-fact">{{ section.settings[fact_key] }}</li>
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if facts != blank -%}
          <ul class="bfig-facts" role="list">{{ facts }}</ul>
        {%- endif -%}
      </div>

      <div class="bfig-hero__choose">
        <h2 class="visually-hidden">{{ section.settings.paths_heading }}</h2>
        <ul class="bfig-paths" role="list">
          <li>
            {%- if real_index == 0 -%}
              <a
                class="bfig-path bfig-path--develop"
                href="#bfig-how"
                data-bfig-when="before"
                {% unless phase == 'before' %}
                  hidden
                {% endunless %}
              >
                <span class="bfig-path__title">{{ section.settings.develop_title }}</span>
                <span class="bfig-path__badge">{{ section.settings.develop_badge }}</span>
                <span class="bfig-path__text">{{ section.settings.develop_text_before }}</span>
                <span class="bfig-path__go">{{ section.settings.develop_go_before }}{{ arrow }}</span>
              </a>
            {%- endif -%}
            <a
              class="bfig-path bfig-path--develop"
              href="{{ section.settings.develop_link }}"
              data-bfig-when="live"
              {% unless phase == 'live' %}
                hidden
              {% endunless %}
            >
              <span class="bfig-path__title">{{ section.settings.develop_title }}</span>
              <span class="bfig-path__badge">{{ section.settings.develop_badge }}</span>
              <span class="bfig-path__text">{{ section.settings.develop_text }}</span>
              <span class="bfig-path__go">{{ section.settings.develop_go }}{{ arrow }}</span>
            </a>
          </li>
          <li>
            <a class="bfig-path bfig-path--gear" href="{{ section.settings.gear_link }}">
              <span class="bfig-path__title">{{ section.settings.gear_title }}</span>
              <span class="bfig-path__badge">{{ section.settings.gear_badge }}</span>
              {%- if real_index == 0 -%}
                <span
                  class="bfig-path__text"
                  data-bfig-when="before"
                  {% unless phase == 'before' %}
                    hidden
                  {% endunless %}
                >
                  {{- section.settings.gear_text_before -}}
                </span>
              {%- endif -%}
              <span
                class="bfig-path__text"
                data-bfig-when="live"
                {% unless phase == 'live' %}
                  hidden
                {% endunless %}
              >
                {{- section.settings.gear_text -}}
              </span>
              <span class="bfig-path__go">{{ section.settings.gear_go }}{{ arrow }}</span>
            </a>
          </li>
        </ul>

        {%- if section.settings.develop_only_link != blank and section.settings.develop_only_text != blank -%}
          <p
            class="bfig-hero__aside bfig-muted"
            data-bfig-when="live"
            {% unless phase == 'live' %}
              hidden
            {% endunless %}
          >
            {{ section.settings.develop_only_text }}
            <a href="{{ section.settings.develop_only_link }}">{{ section.settings.develop_only_label }}</a>
          </p>
        {%- endif -%}
      </div>
      </div>

      {%- if section.settings.show_photo and section.settings.photo != blank -%}
        <div class="bfig-hero__photo">
          <div class="cfl-hero__film">
            {{
              section.settings.photo
              | image_url: width: 1400
              | image_tag:
                loading: 'lazy',
                widths: '550, 700, 900, 1100, 1400',
                sizes: '(min-width: 1532px) 600px, (min-width: 990px) 38vw, 1px',
                alt: section.settings.photo_alt
            }}
          </div>
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- comment -%} After the sale. {%- endcomment -%}
  <div
    class="bfig-hero__inner bfig-hero__inner--single page-width section-{{ section.id }}-padding"
    data-bfig-when="ended"
    {% unless phase == 'ended' %}
      hidden
    {% endunless %}
  >
    <div class="bfig-hero__intro">
      <h1 class="bfig-hero__title">{{ section.settings.ended_heading }}</h1>
      {%- if section.settings.ended_text != blank -%}
        <p class="bfig-lead">{{ section.settings.ended_text }}</p>
      {%- endif -%}
      {%- if section.settings.ended_button_label != blank -%}
        <div class="bfig-hero__ended">
          <a class="bfig-btn" href="{{ section.settings.ended_button_link | default: section.settings.develop_link }}">
            {{- section.settings.ended_button_label -}}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var clock = document.querySelector('[data-bfig-clock]');
    if (!clock) return;

    var PHASES = ['before', 'live', 'ended'];
    var start = Number(clock.dataset.start) * 1000;
    var end = Number(clock.dataset.end) * 1000;
    var rendered = PHASES.indexOf(clock.dataset.phase);
    var forced = clock.dataset.forced === 'true';

    function apply() {
      var now = Date.now();
      var index = rendered;
      if (!forced) {
        var actual = now < start ? 0 : now < end ? 1 : 2;
        // Forward only: cached HTML can be behind, a slow device clock can too.
        index = Math.max(actual, rendered);
      }

      var phase = PHASES[index];
      var nodes = document.querySelectorAll('[data-bfig-when]');
      for (var i = 0; i < nodes.length; i++) {
        var when = nodes[i].getAttribute('data-bfig-when').split(' ');
        nodes[i].hidden = when.indexOf(phase) === -1;
      }

      // A page left open across a boundary switches over at that moment.
      if (!forced && index < 2) {
        var wait = (index === 0 ? start : end) - now;
        if (wait > 0 && wait < 86400000) window.setTimeout(apply, wait + 1000);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', apply);
    } else {
      apply();
    }
  })();
</script>

