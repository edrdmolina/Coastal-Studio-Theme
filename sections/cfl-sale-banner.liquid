{% comment %}
  A dated promotion for the top of the home page: the offer, its terms, and the
  buttons on one side, one photograph on the other.

  It renders only between "Starts" and "Ends", so a sale can be set up ahead of
  time and comes down by itself — nobody has to remember to remove it at
  midnight. The theme editor always shows it, so it can be previewed before it
  starts. Shopify caches storefront pages, so the switch can lag by a few
  minutes either side; the discount itself is enforced by Shopify at checkout,
  not by this section.

  The headline is an h2 on purpose. The film hero below carries the page's only
  h1 and the search wording the home page ranks on; a week-long sale shouldn't
  take that over.

  SPEED
  While it runs, this photograph is the first image on the page and so the
  likely largest contentful paint — it loads eagerly at high priority. The
  sizes attribute follows the grid in cfl-components.css (1rem is 13px): about
  48vw - 20px beside the text from 750px, capped at ~672px, and the viewport
  less 1.5rem of padding each side below that.
{% endcomment %}

{%- liquid
  assign now_s = 'now' | date: '%s' | plus: 0
  assign show = true

  if section.settings.starts_at != blank
    assign starts_s = section.settings.starts_at | date: '%s' | plus: 0
    if now_s < starts_s
      assign show = false
    endif
  endif

  if section.settings.ends_at != blank
    assign ends_s = section.settings.ends_at | date: '%s' | plus: 0
    if now_s >= ends_s
      assign show = false
    endif
  endif

  if request.design_mode
    assign show = true
  endif
-%}

{%- if show -%}
  {{ 'cfl-components.css' | asset_url | stylesheet_tag }}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
    <div class="cfl-sale{% if section.settings.image != blank %} cfl-sale--split{% endif %}">
      <div class="cfl-sale__text">
        {%- if section.settings.eyebrow != blank -%}
          <p class="cfl-sale__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        <h2 class="cfl-sale__title">{{ section.settings.heading | escape }}</h2>

        {%- if section.settings.subheading != blank -%}
          <p class="cfl-sale__sub">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}

        {%- if section.settings.terms != blank -%}
          <p class="cfl-sale__terms">{{ section.settings.terms | escape }}</p>
        {%- endif -%}

        {%- if section.settings.primary_label != blank or section.settings.secondary_label != blank -%}
          <div class="cfl-sale__actions">
            {%- if section.settings.primary_label != blank -%}
              <a
                class="button button--primary"
                href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}"
              >
                {{- section.settings.primary_label | escape -}}
              </a>
            {%- endif -%}

            {%- if section.settings.secondary_label != blank -%}
              <a
                class="button button--secondary"
                href="{{ section.settings.secondary_link | default: routes.all_products_collection_url }}"
              >
                {{- section.settings.secondary_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.image != blank -%}
        <div class="cfl-sale__media">
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '400, 550, 700, 900, 1100, 1400',
              sizes: '(min-width: 1456px) 672px, (min-width: 750px) calc(48vw - 20px), calc(100vw - 39px)',
              alt: section.settings.image_alt
          }}
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Sale banner",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "A dated promotion: the offer and its terms on the left, one photograph on the right. Shows only between the start and end times below, but always in the theme editor."
    },
    {
      "type": "text",
      "id": "starts_at",
      "label": "Starts",
      "info": "Date and time with the UTC offset, e.g. 2026-10-31T00:00:00-04:00. Leave empty to show right away."
    },
    {
      "type": "text",
      "id": "ends_at",
      "label": "Ends",
      "info": "Same format. The banner disappears at this moment. Match it to the discount's end time in Shopify."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Optional small line above the headline."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "15% off develop & scan, this week only"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Supporting sentence"
    },
    {
      "type": "text",
      "id": "terms",
      "label": "Terms",
      "info": "The condition and the end date, in plain words. Keep it matching the discount in Shopify."
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button",
      "default": "Send in my film"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Photograph"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photograph",
      "info": "A 3:2 landscape works best. Leave empty for text only."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Description",
      "info": "For screen readers. Describe what is in the frame, not the file."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-2"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Sale banner"
    }
  ]
}
{% endschema %}
