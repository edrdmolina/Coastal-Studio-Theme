{%- comment -%}
  Sticky order bar promoting the lab's main service.

  Adapted from the redesign project's `order-bar` section, rendered in this
  theme's palette: darkroom brown surface, warm cream text, processing yellow
  price, teal primary button with a brown label.

  Lives in footer-group.json so it renders on every template without per-file
  edits. It excludes itself on product and cart pages, where it would compete
  with a real Add to Cart.

  It links rather than adds to cart on purpose: Globo puts three required
  options on the service products (Negative Condition, Scan Size, Rush), so the
  product page is a mandatory stop.

  On the Premium page it swaps to the premium service. Living in footer-group
  means one set of settings covers every template, and the standard 35mm
  product it normally promotes is both cheaper and a different service — left
  alone it spends the whole premium page pulling visitors back down a tier.
  Keyed on the template suffix rather than the page handle so renaming the page
  in the admin does not quietly switch the bar back.
{%- endcomment -%}

{%- liquid
  assign show_bar = true

  # Never compete with a real Add to Cart, or with the cart itself.
  if template.name == 'product' or template.name == 'cart'
    assign show_bar = false
  endif

  unless section.settings.enabled
    assign show_bar = false
  endunless

  assign bar_product = section.settings.product
  assign bar_heading = section.settings.heading
  assign bar_sub = section.settings.subheading
  assign bar_primary_label = section.settings.primary_label
  assign bar_secondary_label = section.settings.secondary_label
  assign bar_secondary_link = section.settings.secondary_link

  if page.template_suffix == 'premium-page'
    assign bar_heading = section.settings.premium_heading
    assign bar_sub = section.settings.premium_subheading
    assign bar_primary_label = section.settings.premium_primary_label
    assign bar_secondary_label = section.settings.premium_secondary_label
    assign bar_secondary_link = section.settings.premium_secondary_link

    if section.settings.premium_product != blank
      assign bar_product = section.settings.premium_product
    endif
  endif

  if bar_product == blank
    assign show_bar = false
  endif
-%}

{%- if show_bar -%}
  <aside
    class="cfl-order-bar"
    id="CflOrderBar"
    data-cfl-order-bar
    data-reveal-at="{{ section.settings.reveal_at }}"
    aria-label="{{ bar_heading | default: 'Order film developing' | escape }}"
  >
    <div class="cfl-order-bar__inner">
      <div class="cfl-order-bar__text">
        <p class="cfl-order-bar__heading">{{ bar_heading }}</p>
        {%- if bar_sub != blank -%}
          <p class="cfl-order-bar__sub">{{ bar_sub }}</p>
        {%- endif -%}
      </div>

      <div class="cfl-order-bar__actions">
        {%- if section.settings.show_price and bar_product.price > 0 -%}
          {%- assign bar_price = bar_product.price | money -%}
          <span class="cfl-order-bar__price">
            {{- 'products.product.price.from_price_html' | t: price: bar_price -}}
          </span>
        {%- endif -%}

        <a href="{{ bar_product.url }}" class="button cfl-order-bar__cta">
          {{ bar_primary_label }}
        </a>

        {%- if bar_secondary_label != blank and bar_secondary_link != blank -%}
          <a
            href="{{ bar_secondary_link }}"
            class="button cfl-order-bar__cta cfl-order-bar__cta--secondary"
          >
            {{ bar_secondary_label }}
          </a>
        {%- endif -%}
      </div>

      <button
        type="button"
        class="cfl-order-bar__dismiss"
        data-cfl-order-bar-dismiss
        aria-controls="CflOrderBar"
      >
        <span class="visually-hidden">{{ 'accessibility.close' | t }}</span>
        {% render 'icon-close' %}
      </button>
    </div>
  </aside>

  <script>
    (function () {
      var KEY = 'cfl-order-bar-dismissed';
      var bar = document.getElementById('CflOrderBar');
      if (!bar) return;

      function dismissed() {
        try {
          return window.sessionStorage.getItem(KEY) === '1';
        } catch (e) {
          // Private browsing can throw on access; show the bar rather than fail.
          return false;
        }
      }

      if (dismissed()) {
        bar.remove();
        return;
      }

      // The footer being on screen means the visitor has reached the page's own
      // calls to action, so the bar gets out of the way. An observer is accurate
      // whatever the footer's height, unlike measuring against scrollHeight.
      var footerVisible = false;
      var footer = document.querySelector('.footer');
      if (footer && 'IntersectionObserver' in window) {
        new IntersectionObserver(function (entries) {
          footerVisible = entries[0].isIntersecting;
          update();
          // The footer here is ~1000px tall. Waiting until a few hundred
          // pixels of it are actually on screen keeps the bar useful for
          // meaningfully longer without ever overlapping the footer links.
        }, { rootMargin: '0px 0px -320px 0px' }).observe(footer);
      }

      // Viewport-relative rather than a fixed pixel count: this bar renders on
      // every template and each one has a differently sized hero.
      var revealAt = parseFloat(bar.dataset.revealAt);
      if (isNaN(revealAt)) revealAt = 45;

      function pastHero() {
        var y = window.scrollY || window.pageYOffset;
        return y > window.innerHeight * (revealAt / 100);
      }

      function update() {
        bar.classList.toggle('cfl-order-bar--show', pastHero() && !footerVisible);
      }

      bar.querySelector('[data-cfl-order-bar-dismiss]').addEventListener('click', function () {
        try {
          window.sessionStorage.setItem(KEY, '1');
        } catch (e) {
          // Non-fatal — the bar still goes away for this page view.
        }
        bar.classList.remove('cfl-order-bar--show');
        window.setTimeout(function () {
          bar.remove();
        }, 400);
      });

      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update, { passive: true });
      update();
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Sticky order bar",
  "settings": [
    {
      "type": "paragraph",
      "content": "Appears on every page except product and cart pages, once the visitor scrolls past the hero."
    },
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable",
      "default": true
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product to promote",
      "info": "The price shown is pulled from this product."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to develop your film?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "35mm C-41 developed and scanned, delivered over Google Drive."
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "range",
      "id": "reveal_at",
      "label": "Reveal after scrolling",
      "info": "Percent of one screen height. Lower shows the bar sooner.",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Start an order"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Other film types"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Premium Processing page"
    },
    {
      "type": "paragraph",
      "content": "Used only on the Premium Processing page, which sells a different, higher tier. Without these the bar promotes the standard service there."
    },
    {
      "type": "product",
      "id": "premium_product",
      "label": "Premium product to promote",
      "info": "The price shown on the Premium page is pulled from this product."
    },
    {
      "type": "text",
      "id": "premium_heading",
      "label": "Premium heading",
      "default": "Ready to order Premium?"
    },
    {
      "type": "text",
      "id": "premium_subheading",
      "label": "Premium subheading",
      "default": "Extra large scans, hand-edited to your color profile."
    },
    {
      "type": "text",
      "id": "premium_primary_label",
      "label": "Premium primary button label",
      "default": "Order Premium"
    },
    {
      "type": "text",
      "id": "premium_secondary_label",
      "label": "Premium secondary button label",
      "default": "All Premium formats"
    },
    {
      "type": "url",
      "id": "premium_secondary_link",
      "label": "Premium secondary button link"
    }
  ],
  "enabled_on": {
    "groups": [
      "footer"
    ]
  }
}
{% endschema %}
