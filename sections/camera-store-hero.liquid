{{ 'camera-store.css' | asset_url | stylesheet_tag }}

<div class="camera-store cs-hero-section">
  <div class="cs-shell">
    <nav class="cs-breadcrumb" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span><span>Camera store</span></nav>
    <div class="cs-hero">
      <div class="cs-hero__copy">
        <p class="cs-eyebrow"><span class="cs-dot"></span> {{ section.settings.eyebrow | escape }}</p>
        <h1>{{ section.settings.heading | escape | newline_to_br }}</h1>
        <p class="cs-hero__description">{{ section.settings.description | escape }}</p>
        <div class="cs-actions">
          <a class="cs-button" href="#CameraInventory">Shop available cameras {% render 'camera-store-icon', icon: 'arrow' %}</a>
          <a class="cs-text-link" href="#CameraFinder">Help me choose <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="cs-hero__media">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1600 | image_tag: widths: '480, 750, 1000, 1300, 1600', sizes: '(min-width: 990px) 48vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: 'A selection of classic film cameras at Coastal Film Lab' }}
        {% else %}
          {{ 'collection-2' | placeholder_svg_tag: 'cs-placeholder' }}
        {% endif %}
        <div class="cs-hero__label"><span>COASTAL CAMERA STORE</span><span>TAMPA, FL ↗</span></div>
      </div>
    </div>
    <div class="cs-promises">
      <a href="#CameraConfidence">{% render 'camera-store-icon', icon: 'camera' %}<span><strong>More than a battery check</strong><span>Our 20-point inspection. AS-IS excluded.</span></span></a>
      <a href="{{ section.settings.warranty_url }}">{% render 'camera-store-icon', icon: 'shield' %}<span><strong>90-day limited warranty</strong><span>On used gear, except AS-IS. Terms apply.</span></span></a>
      <a href="{{ section.settings.contact_url }}">{% render 'camera-store-icon', icon: 'box' %}<span><strong>Real people. A real film lab.</strong><span>Camera advice & shipping from Tampa, Florida.</span></span></a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Camera store: intro",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Good cameras. Real film people."
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Find your next\nfilm camera."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Your first roll or your next obsession. Shop new and pre-owned cameras from the people who develop your film, with clear condition notes and a little help when you need it."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero photograph"
    },
    {
      "type": "url",
      "id": "warranty_url",
      "label": "Grading and warranty page"
    },
    {
      "type": "url",
      "id": "contact_url",
      "label": "Contact page"
    }
  ],
  "presets": [
    {
      "name": "Camera store: intro"
    }
  ]
}
{% endschema %}
