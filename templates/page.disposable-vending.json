o__camera\"\n    \/>\n  <\/div>\n\n<\/body>","color_scheme":"background-2","padding_top":0,"padding_bottom":0}},"rich_text_HXfpfM":{"type":"rich-text","blocks":{"text_CrjKW4":{"type":"text","settings":{"text":"<p>Our Coastal Branded Disposable Cameras include Develop and Scan! Please fill out the form below with your information, so we know who the camera belongs to. <br\/>Then, drop off your camera at one of our dropboxes at Black Crow Coffee Grand Central, Park & Rec DTSP, or our brick-and-mortar in Tampa, FL.<\/p>"}}},"block_order":["text_CrjKW4"],"custom_css":["p {color: #000000;}","a {color: #000000;}"],"name":"t:sections.rich-text.presets.name","settings":{"desktop_content_position":"center","content_alignment":"center","color_scheme":"background-2","full_width":true,"padding_top":0,"padding_bottom":24}},"1765486026b745759a":{"type":"apps","blocks":{"vendingdispo_register_form_mjmqHc":{"type":"shopify:\/\/apps\/vendingdispo\/blocks\/register-form\/019dd616-2d50-71c3-b9f6-2fab820d3266","settings":{"heading":"Register Your Camera","description":"Enter the code from your camera and your shipping details to receive your developed photos."}}},"block_order":["vendingdispo_register_form_mjmqHc"],"custom_css":[".shopify-app-block {padding-bottom: 50px;}"],"settings":{"include_margins":true}}},"order":["main","custom_liquid_zXK8K7","rich_text_HXfpfM","1765486026b745759a"]}