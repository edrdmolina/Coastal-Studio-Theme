{"sections":{"main":{"type":"main-page","disabled":true,"settings":{"padding_top":28,"padding_bottom":28}},"custom_liquid_YaDLLP":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<style>\n  body {\n    background: #f8f4ed;\n    font-family: 'Inter', 'Helvetica Neue', Arial, sans-serif;\n    margin: 0;\n    padding: 0;\n  }\n  .header-image {\n    width: 100%;\n    height: 100%;\n  }\n  .header-image img {\n    width: 100%;\n    max-width: 100%;\n    display: block;\n    margin: 0 auto;\n    object-fit: cover;\n    height: 100%;\n  }\n  .row {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    justify-content: center;\n    margin: 3rem auto;\n    max-width: 1100px;\n    width: 100%;\n    background: none;\n  }\n  .col {\n    flex: 1 1 0;\n    width: 60%;\n    max-width: 60%;\n    box-sizing: border-box;\n    padding: 1.5rem;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n  }\n  .col img {\n    max-width: 100%;\n    border-radius: 10px;\n    display: block;\n  }\n  .step {\n    font-size: 1.8rem;\n    font-weight: 700;\n    color: #009ea3;\n    text-transform: uppercase;\n    letter-spacing: 0.05em;\n    margin-bottom: 1rem;\n    display: flex;\n    align-items: center;\n    gap: 0.5rem;\n    justify-content: flex-start;\n    width: 100%;\n  }\n  .step img {\n    display: inline-block;\n    vertical-align: middle;\n    max-width: 400px;\n    margin: 0;\n    border-radius: 0;\n  }\n  .step-description {\n    font-size: 1.3rem;\n    color: #333;\n    line-height: 1.6;\n    max-width: 500px;\n    font-weight: 400;\n    margin-bottom: 0;\n    margin-top: 0.5rem;\n    text-align: left;\n  }\n  .archival-modal-buttons {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    margin: 2rem 0;\n    gap: 0.5rem;\n    flex-wrap: wrap;\n  }\n  .archival-modal-buttons > button {\n    margin: 0.5rem;\n  }\n  .archival-modal-buttons > button:hover,\n  .archival-modal-buttons > button:focus {\n    background-color: #23bfc2;\n    color: #fff;\n  }\n  .archival-modal[data-archival-modal-instance] {\n    \/* background: rgba(248,244,237,0.98); *\/\n    \/* Keep modal fixed and centered *\/\n  }\n  .archival-modal__dialog {\n    background-color: #fff !important;\n    \/* inherit beige *\/\n  }\n  @media (max-width: 768px) {\n    .archival-modal__dialog {\n      width: 95vw !important;\n      height: 95vh !important;\n      max-width: 95vw !important;\n      max-height: 95vh !important;\n    }\n  }\n  \/* Responsive Styles *\/\n  @media (max-width: 900px) {\n    .row {\n      max-width: 98vw;\n    }\n    .col {\n      padding: 1rem;\n    }\n    .step img {\n      max-width: 350px;\n    }\n  }\n  @media (max-width: 768px) {\n    .row {\n      flex-direction: column !important;\n      align-items: stretch;\n      margin: 2rem 0;\n      text-align: center;\n    }\n    .col {\n      width: 100%;\n      max-width: 100%;\n      padding: 1rem 0.5rem;\n      align-items: center;\n      justify-content: flex-start;\n      text-align: center;\n    }\n    .step-description {\n      text-align: center;\n      margin-left: auto;\n      margin-right: auto;\n    }\n    .step {\n      justify-content: center;\n      width: 100%;\n    }\n  }\n  @media (max-width: 480px) {\n    .step img {\n      max-width: 300px;\n    }\n    .archival-modal__dialog {\n      padding: 1rem;\n    }\n    .row {\n      margin: 1rem 0;\n    }\n  }\n<\/style>\n\n\n<div>\n    <div class=\"row\">\n        <!-- <div class=\"header-image\">\n            <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/HEADER-text-archival.png?v=1761944170\" alt=\"header text\"\/>\n        <\/div> -->\n        <h1>Archival Box Guide<\/h1>\n    <\/div>\n\n    <div class=\"row\"> \n        <div class=\"col\">\n            <div class=\"step\">\n                <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/archivalpagewords-10.png?v=1762207467\" alt=\"Step 1: Count your items\" \/>\n            <\/div>\n            <div class=\"step-description\">\n                Gather your film, slides, prints, and tapes. Organize them into piles and count how many of each you have. Use the <strong>\"Audio & Video\", \"Physical Prints\", and \"Film\"<\/strong> buttons to find out how many items each piece of media equals one item.\n            <\/div>\n        <\/div>\n        <div class=\"col\">\n            <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/IMAGE_STEP_1-text-archival.png?v=1761944171\" alt=\"Step 1: Count your items image\" \/>\n        <\/div>\n    <\/div>\n        <!-- <div class=\"row\">\n        <style>\n            .archival-modal-buttons > button {\n                margin: 0.5rem;\n            }\n\n            .archival-modal[data-archival-modal-instance] {\n                position: fixed;\n                inset: 0;\n                z-index: 1000;\n                display: flex;\n                align-items: center;\n                justify-content: center;\n                \/* background: rgba(248,244,237,0.98); *\/\n            }\n            .archival-modal[data-archival-modal-instance][hidden] {\n                display: none !important;\n            }\n            .archival-modal__backdrop {\n                position: absolute;\n                inset: 0;\n                background-color: rgba(0, 0, 0, 0.5);\n            }\n            .archival-modal__dialog {\n                position: relative;\n                height: 80vh;\n                width: 80vw;\n                max-height: 80vh;\n                max-width: 80vw;\n                background-color: #fff !important;\n                border-radius: 20px;\n                box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);\n                z-index: 1;\n                display: grid;\n                grid-template-rows: auto 1fr;\n                overflow: hidden; \/* body will scroll *\/\n            }\n            @media (max-width: 768px) {\n                .archival-modal__dialog {\n                    width: 95vw !important;\n                    height: 95vh !important;\n                    max-width: 95vw !important;\n                    max-height: 95vh !important;\n                }\n            }\n            .archival-modal__header {\n                position: sticky;\n                top: 0;\n                z-index: 2;\n                background: #fff;\n                display: flex;\n                justify-content: flex-end;\n                padding: 1rem 1.5rem 0 1.5rem; \/* top padding separates from edge *\/\n            }\n            .archival-modal__close {\n                border: none;\n                background: transparent;\n                cursor: pointer;\n                display: flex;\n                align-items: center;\n                justify-content: center;\n                padding: 0.5rem;\n            }\n            \/* Inline SVG close button styling *\/\n            .archival-modal__close svg {\n                width: 4rem;\n                height: 4rem;\n                pointer-events: none;\n                transition: stroke 0.2s ease;\n            }\n            .archival-modal__close svg path {\n                stroke: #009ea3;\n                transition: stroke 0.2s ease;\n            }\n            .archival-modal__close:hover svg path {\n                stroke: #23bfc2;\n            }\n            .archival-modal__body {\n                margin-top: 0;\n                padding: 1.5rem 2rem 2rem;\n                overflow: auto; \/* scrolls independently *\/\n            }\n\n            \/* Hide qty + add-to-cart variants inside modal (covers Dawn\/Theme variations and quick-add) *\/\n            .archival-modal__dialog form[action*=\"\/cart\/add\"],\n            .archival-modal__dialog button[name=\"add\"],\n            .archival-modal__dialog button[type=\"submit\"][name=\"add\"],\n            .archival-modal__dialog .product-form__buttons,\n            .archival-modal__dialog .product-form__submit,\n            .archival-modal__dialog .product-form__quantity,\n            .archival-modal__dialog .quantity,\n            .archival-modal__dialog .quantity__input,\n            .archival-modal__dialog .quantity__button,\n            .archival-modal__dialog .quantity-selector,\n            .archival-modal__dialog .quick-add,\n            .archival-modal__dialog .quick-add__submit,\n            .archival-modal__dialog .product-card__buttons,\n            .archival-modal__dialog .shopify-payment-button,\n            .archival-modal__dialog .shopify-payment-button__button,\n            .archival-modal__dialog .shopify-payment-button__button--unbranded,\n            .archival-modal__dialog .shopify-payment-button__more-options {\n                display: none !important;\n            }\n\n            \/* Hide AI quantity selector and similar dynamic quantity controls inside modal *\/\n            .archival-modal__dialog [class*=\"ai-quantity\"],\n            .archival-modal__dialog [class*=\"ai-quantity-\"],\n            .archival-modal__dialog [class*=\"quantity-anwjx\"],\n            .archival-modal__dialog [class*=\"quantity-selector\"],\n            .archival-modal__dialog [class*=\"ai-addtocart\"],\n            .archival-modal__dialog [class*=\"ai-cart\"],\n            .archival-modal__dialog [class*=\"add-to-cart\"] {\n                display: none !important;\n            }\n        <\/style>\n\n        <div class=\"archival-modal-wrapper\" data-archival-modal>\n            <div class=\"row archival-modal-buttons\">\n                <button class=\"button button--primary\" type=\"button\" data-link=\"https:\/\/www.coastalfilmlab.com\/pages\/audio-video-archival\">AUDIO &amp; VIDEO<\/button>\n                <button class=\"button button--primary\" type=\"button\" data-link=\"https:\/\/www.coastalfilmlab.com\/pages\/print-archival\">PHYSICAL PRINTS<\/button>\n                <button class=\"button button--primary\" type=\"button\" data-link=\"https:\/\/www.coastalfilmlab.com\/pages\/film-archival\">FILM<\/button>\n            <\/div>\n\n            <div class=\"archival-modal\" data-archival-modal-instance hidden>\n                <div class=\"archival-modal__backdrop\" data-modal-close><\/div>\n                <div class=\"archival-modal__dialog\" role=\"dialog\" aria-modal=\"true\" aria-live=\"polite\">\n                    <div class=\"archival-modal__header\">\n                        <button class=\"archival-modal__close button button--secondary\" type=\"button\" aria-label=\"Close modal\" data-modal-close>\n                          <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" viewBox=\"0 0 24 24\">\n                            <path d=\"M18 6L6 18M6 6l12 12\"\n                                  fill=\"none\"\n                                  stroke=\"#009ea3\"\n                                  stroke-width=\"2\"\n                                  stroke-linecap=\"round\"\n                                  stroke-linejoin=\"round\" \/>\n                          <\/svg>\n                        <\/button>\n                    <\/div>\n                    <div class=\"archival-modal__body\" data-modal-content><\/div>\n                <\/div>\n            <\/div>\n\n            <script>\n                (function () {\n                    const currentScript = document.currentScript;\n                    if (!currentScript) {\n                        return;\n                    }\n\n                    const container = currentScript.closest('[data-archival-modal]');\n                    if (!container || container.dataset.modalInitialized === 'true') {\n                        return;\n                    }\n                    container.dataset.modalInitialized = 'true';\n\n                    const ensureStyles = () => {\n                        const styleId = 'archival-modal-styles';\n                        if (document.getElementById(styleId)) {\n                            return;\n                        }\n\n                        const style = document.createElement('style');\n                        style.id = styleId;\n                        style.textContent = `\n                            .archival-modal[data-archival-modal-instance] {\n                                position: fixed;\n                                inset: 0;\n                                z-index: 1000;\n                                display: flex;\n                                align-items: center;\n                                justify-content: center;\n                                \/* background: rgba(248,244,237,0.98); *\/\n                            }\n                            .archival-modal[data-archival-modal-instance][hidden] {\n                                display: none !important;\n                            }\n                            .archival-modal__backdrop {\n                                position: absolute;\n                                inset: 0;\n                                background-color: rgba(0, 0, 0, 0.5);\n                            }\n                            .archival-modal__dialog {\n                                position: relative;\n                                height: 80vh;\n                                width: 80vw;\n                                max-height: 80vh;\n                                max-width: 80vw;\n                                background-color: #fff !important;\n                                border-radius: 20px;\n                                box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);\n                                z-index: 1;\n                                display: grid;\n                                grid-template-rows: auto 1fr;\n                                overflow: hidden; \/* body will scroll *\/\n                            }\n                            .archival-modal__header {\n                                position: sticky;\n                                top: 0;\n                                z-index: 2;\n                                background: #fff;\n                                display: flex;\n                                justify-content: flex-end;\n                                padding: 1rem 1.5rem 0 1.5rem;\n                            }\n                            .archival-modal__close {\n                                border: none;\n                                background: transparent;\n                                cursor: pointer;\n                                display: flex;\n                                align-items: center;\n                                justify-content: center;\n                                padding: 0.5rem;\n                            }\n                            .archival-modal__close svg {\n                                width: 4rem;\n                                height: 4rem;\n                                pointer-events: none;\n                                transition: stroke 0.2s ease;\n                            }\n                            .archival-modal__close svg path {\n                                stroke: #009ea3;\n                                transition: stroke 0.2s ease;\n                            }\n                            .archival-modal__close:hover svg path {\n                                stroke: #23bfc2;\n                            }\n                            .archival-modal__body {\n                                margin-top: 0;\n                                padding: 1.5rem 2rem 2rem;\n                                overflow: auto; \/* scrolls independently *\/\n                            }\n                            \/* Hide qty + add-to-cart variants inside modal (covers Dawn\/Theme variations and quick-add) *\/\n                            .archival-modal__dialog form[action*=\"\/cart\/add\"],\n                            .archival-modal__dialog button[name=\"add\"],\n                            .archival-modal__dialog button[type=\"submit\"][name=\"add\"],\n                            .archival-modal__dialog .product-form__buttons,\n                            .archival-modal__dialog .product-form__submit,\n                            .archival-modal__dialog .product-form__quantity,\n                            .archival-modal__dialog .quantity,\n                            .archival-modal__dialog .quantity__input,\n                            .archival-modal__dialog .quantity__button,\n                            .archival-modal__dialog .quantity-selector,\n                            .archival-modal__dialog .quick-add,\n                            .archival-modal__dialog .quick-add__submit,\n                            .archival-modal__dialog .product-card__buttons,\n                            .archival-modal__dialog .shopify-payment-button,\n                            .archival-modal__dialog .shopify-payment-button__button,\n                            .archival-modal__dialog .shopify-payment-button__button--unbranded,\n                            .archival-modal__dialog .shopify-payment-button__more-options {\n                                display: none !important;\n                            }\n                            `;\n\n                        document.head.appendChild(style);\n                    };\n\n                    ensureStyles();\n\n                    const modal = container.querySelector('[data-archival-modal-instance]');\n                    const modalContent = modal?.querySelector('[data-modal-content]');\n                    const closeTriggers = modal?.querySelectorAll('[data-modal-close]');\n                    const openTriggers = container.querySelectorAll('.archival-modal-buttons [data-link]');\n\n                    if (!modal || !modalContent) {\n                        console.warn('Archival modal markup is missing.');\n                        return;\n                    }\n\n                    if (!modal.dataset.archivalModalMounted) {\n                        document.body.appendChild(modal);\n                        modal.dataset.archivalModalMounted = 'true';\n                    }\n\n                    openTriggers.forEach((trigger) => {\n                        trigger.setAttribute('aria-haspopup', 'dialog');\n                        trigger.setAttribute('aria-expanded', 'false');\n                    });\n\n                    let keydownHandler;\n                    let lastActiveElement;\n                    let activeTrigger;\n\n                    const lockScroll = () => {\n                        if (!document.body.dataset.archivalModalScrollLock) {\n                            document.body.dataset.archivalModalScrollLock = document.body.style.overflow || '';\n                        }\n                        document.body.style.overflow = 'hidden';\n                    };\n\n                    const unlockScroll = () => {\n                        const previous = document.body.dataset.archivalModalScrollLock;\n                        document.body.style.overflow = previous || '';\n                        delete document.body.dataset.archivalModalScrollLock;\n                    };\n\n                    const hideModal = () => {\n                        modal.setAttribute('hidden', '');\n                        modalContent.innerHTML = '';\n                        unlockScroll();\n\n                        if (keydownHandler) {\n                            document.removeEventListener('keydown', keydownHandler);\n                            keydownHandler = undefined;\n                        }\n\n                        if (activeTrigger) {\n                            activeTrigger.setAttribute('aria-expanded', 'false');\n                            activeTrigger.focus();\n                            activeTrigger = undefined;\n                        } else if (lastActiveElement instanceof HTMLElement) {\n                            lastActiveElement.focus();\n                        }\n                    };\n\n                    const showModal = () => {\n                        lastActiveElement = document.activeElement instanceof HTMLElement ? document.activeElement : undefined;\n                        modal.removeAttribute('hidden');\n                        lockScroll();\n\n                        keydownHandler = (event) => {\n                            if (event.key === 'Escape') {\n                                hideModal();\n                            }\n                        };\n\n                        document.addEventListener('keydown', keydownHandler);\n\n                        const focusTarget = modal.querySelector('[data-modal-close]') || modal.querySelector('[tabindex]');\n                        if (focusTarget instanceof HTMLElement) {\n                            focusTarget.focus();\n                        }\n                    };\n\n                    const resolveLink = (value) => {\n                        if (!value) {\n                            return null;\n                        }\n\n                        try {\n                            return new URL(value, window.location.origin).toString();\n                        } catch (error) {\n                            console.warn('Invalid data-link value provided:', value);\n                            return null;\n                        }\n                    };\n\n                    const scriptCache = new Set();\n\n                    const extractMainContent = (htmlText) => {\n                        const parser = new DOMParser();\n                        const parsedDocument = parser.parseFromString(htmlText, 'text\/html');\n                        const mainContent = parsedDocument.querySelector('#MainContent');\n\n                        if (!mainContent) {\n                            throw new Error('MainContent element not found in the fetched document.');\n                        }\n\n                        const fragment = document.createDocumentFragment();\n\n                        Array.from(mainContent.childNodes).forEach((node) => {\n                            fragment.appendChild(node.cloneNode(true));\n                        });\n\n                        return fragment;\n                    };\n\n                    const activateScripts = (root) => {\n                        const scripts = root.querySelectorAll('script');\n                        scripts.forEach((script) => {\n                            const type = script.type?.trim();\n\n                            if (type && type !== 'module' && type !== 'text\/javascript') {\n                                return;\n                            }\n\n                            const signature = script.src || script.textContent.trim();\n\n                            if (!signature || scriptCache.has(signature)) {\n                                script.remove();\n                                return;\n                            }\n\n                            scriptCache.add(signature);\n\n                            const executableScript = document.createElement('script');\n\n                            Array.from(script.attributes).forEach((attr) => {\n                                executableScript.setAttribute(attr.name, attr.value);\n                            });\n\n                            if (script.src) {\n                                executableScript.src = script.src;\n                            } else {\n                                executableScript.textContent = script.textContent;\n                            }\n\n                            script.replaceWith(executableScript);\n                        });\n                    };\n\n                    const loadContent = async (link) => {\n                        modalContent.innerHTML = '<p>Loading...<\/p>';\n\n                        try {\n                            const response = await fetch(link, { credentials: 'same-origin' });\n\n                            if (!response.ok) {\n                                throw new Error('Failed to load content: ' + response.status + ' ' + response.statusText);\n                            }\n\n                            const rawHtml = await response.text();\n                            const fragment = extractMainContent(rawHtml);\n                            modalContent.innerHTML = '';\n                            modalContent.appendChild(fragment);\n                            activateScripts(modalContent);\n                        } catch (error) {\n                            console.error(error);\n                            modalContent.innerHTML = '<p>Sorry, we could not load this content right now.<\/p>';\n                        }\n                    };\n\n                    openTriggers.forEach((trigger) => {\n                        trigger.addEventListener('click', (event) => {\n                            event.preventDefault();\n\n                            const link = resolveLink(trigger.dataset.link);\n                            if (!link) {\n                                console.warn('No valid data-link provided for this trigger.');\n                                return;\n                            }\n\n                            activeTrigger = trigger;\n                            trigger.setAttribute('aria-expanded', 'true');\n                            showModal();\n                            loadContent(link);\n                        });\n                    });\n\n                    closeTriggers?.forEach((trigger) => {\n                        trigger.addEventListener('click', hideModal);\n                    });\n                })();\n            <\/script>\n        <\/div> -->\n    <\/div>\n    <div class=\"row\"> \n        <div class=\"col\">\n            <div class=\"step\">\n                <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/archivalpagewords-11.png?v=1762207471\" alt=\"Step 2: Load your box\" \/>\n            <\/div>\n            <div class=\"step-description\">\n                Put each type of item into a separate bag and load into the Coastal Archiving Box with bubble wrap or paper padding the top, bottom, and sides. Place the provided shipping label on the box and drop it off at your nearest USPS location. If you're local, you're welcome to drop it off at our location in Tampa, FL.\n            <\/div>\n        <\/div>\n        <div class=\"col\">\n            <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/IMAGE_STEP_2-text-archival.png?v=1761944171\" alt=\"Step 2: Load your box image\" \/>\n        <\/div>\n    <\/div>\n    <div class=\"row\"> \n        <div class=\"col\">\n            <div class=\"step\">\n                <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/archivalpagewords-12.png?v=1762207475\" alt=\"Step 3: Receive your memories\" \/>\n            <\/div>\n            <div class=\"step-description\">\n                Once we receive your box, we will check it into the order queue. Coastal archivists will digitize, restore, and organize your entire order and provide the digital copies via download or usb. \n            <\/div>\n        <\/div>\n        <div class=\"col\">\n            <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/IMAGE_STEP_3-text-archival.png?v=1761944171\" alt=\"Step 3: Receive your memories image\" \/>\n        <\/div>\n    <\/div>\n    <div class=\"row\">\n        <div class=\"col\" style=\"text-align: center;\">\n            <h2>Need Help?<\/h2>\n            <p>If you have any questions about the Archival Box process, please don't hesitate to reach out to our Archival team at <a href=\"mailto:archival@coastalfilm.com\">archival@coastalfilm.com<\/a>.<\/p>\n        <\/div>\n    <\/div>\n<\/div>","color_scheme":"","padding_top":40,"padding_bottom":52}}},"order":["main","custom_liquid_YaDLLP"]}