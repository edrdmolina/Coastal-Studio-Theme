   <video\n                    src=\"https:\/\/cdn.shopify.com\/videos\/c\/o\/v\/e430947a02264a97a44b8aea7e8d9958.mov\"\n                    playsinline\n                    muted\n                    loop\n                >\n                <\/video>\n                <button class=\"video-play-btn\" aria-label=\"Play\/Pause video\">\n                    <svg class=\"play-icon\" viewBox=\"0 0 24 24\" fill=\"currentColor\">\n                        <path d=\"M8 5v14l11-7z\"\/>\n                    <\/svg>\n                    <svg class=\"pause-icon\" viewBox=\"0 0 24 24\" fill=\"currentColor\">\n                        <path d=\"M6 19h4V5H6v14zm8-14v14h4V5h-4z\"\/>\n                    <\/svg>\n                <\/button>\n                <a href=\"https:\/\/www.instagram.com\/reel\/DSdX150kTwr\/?utm_source=ig_web_copy_link&igsh=MzRlODBiNWFlZA==\" class=\"video-link-overlay\" target=\"_blank\">&nbsp;<\/a>\n            <\/div>\n            \n        <\/div>\n    <\/section>\n\n\n<!-- Perks section -->\n<section class=\"perks-section\">\n  <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/coastalcollabstable.png?v=1768336317\" alt=\"Collabs perks table\" \/>\n<\/section>\n\n\n\n\n\n    <!-- Who We're Looking For Section -->\n    <section class=\"looking-for-section\">\n        <h2>WHO ARE WE LOOKING FOR? 🥹<\/h2>\n        <div class=\"looking-for-content\">\n            <div class=\"profile-image\">\n                <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/coastalcollabs-assets-18.png?v=1768333703\" alt=\"Film photographer profile\">\n            <\/div>\n            <div class=\"criteria-text\">\n                <p>\n                    We're not looking for follower counts or viral numbers. What\n                    matters most to us is community. If you have people who love\n                    photography, are curious about film, or trust your creative\n                    recommendations, you're a great fit. Our goal with this program is to\n                    help more people get into film photography, support meaningful\n                    creative work, and keep film alive.\n                <\/p>\n            <\/div>\n        <\/div>\n        <a class=\"button button--primary\" href=\"https:\/\/api.collabs.shopify.com\/creator\/signup\/community_application\/1c5d67cecc23ef93?origin=THEME_EXTENSION\" target=\"_blank\">CREATE WITH COASTAL!<\/a>\n    <\/section>\n\n    <!-- Community Examples Section -->\n    <section class=\"community-section\">\n        <div class=\"community-gallery\">\n            <a href=\"https:\/\/www.instagram.com\/expiredfilmclub\" class=\"community-item\" target=\"_blank\">\n                <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/coastalcollabs-assets-12.png?v=1768333699\" alt=\"Community photo 1\">\n                <p class=\"username\">@expiredfilmclub<\/p>\n            <\/>\n            <a href=\"https:\/\/www.instagram.com\/americantravelarchives\" class=\"community-item\" target=\"_blank\">\n                <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/coastalcollabs-assets-13.png?v=1768333698\" alt=\"Community photo 2\">\n                <p class=\"username\">@americantravelarchives<\/p>\n            <\/a>\n            <a href=\"https:\/\/www.instagram.com\/nataliezacek\" class=\"community-item\" target=\"_blank\">\n                <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/coastalcollabs-assets-14.png?v=1768333721\" alt=\"Community photo 3\">\n                <p class=\"username\">@nataliezacek<\/p>\n            <\/a>\n        <\/div>\n    <\/section>\n\n    <!-- Join Community Section -->\n    <section class=\"join-section\">\n        <h2>JOIN OUR COMMUNITY<\/h2>\n        <div class=\"social-links\">\n            <a href=\"https:\/\/www.instagram.com\/coastalfilmlab\/\" class=\"social-icon instagram\" target=\"_blank\">\n                <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/coastalcollabs-assets-15.png?v=1768333696\" alt=\"Instagram\">\n            <\/a>\n            <a href=\"https:\/\/www.youtube.com\/@coastalfilmlab\" class=\"social-icon youtube\" target=\"_blank\">\n                <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/coastalcollabs-assets-17.png?v=1768333719\" alt=\"YouTube\">\n            <\/a>\n            <a href=\"https:\/\/www.tiktok.com\/@coastalfilmlab\" class=\"social-icon tiktok\" target=\"_blank\">\n                <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/coastalcollabs-17.png?v=1768333695\" alt=\"TikTok\">\n            <\/a>\n        <\/div>\n    <\/section>\n\n\n\n\n    <script>\n        document.addEventListener('DOMContentLoaded', function() {\n            const videoPlayers = document.querySelectorAll('.video-player');\n\n            \/\/ Intersection Observer for scroll-triggered autoplay (75% visible)\n            const observerOptions = {\n                root: null,\n                rootMargin: '0px',\n                threshold: 0.33\n            };\n\n            const videoObserver = new IntersectionObserver((entries) => {\n                entries.forEach(entry => {\n                    const video = entry.target.querySelector('video');\n                    const player = entry.target;\n\n                    if (entry.isIntersecting) {\n                        video.play();\n                        player.classList.add('playing');\n                    } else {\n                        video.pause();\n                        player.classList.remove('playing');\n                    }\n                });\n            }, observerOptions);\n\n            \/\/ Set up each video player\n            videoPlayers.forEach(player => {\n                const video = player.querySelector('video');\n                const playBtn = player.querySelector('.video-play-btn');\n\n                \/\/ Observe for scroll-triggered autoplay\n                videoObserver.observe(player);\n\n                \/\/ Play\/Pause button click handler\n                playBtn.addEventListener('click', function(e) {\n                    e.stopPropagation();\n                    if (video.paused) {\n                        video.play();\n                        player.classList.add('playing');\n                    } else {\n                        video.pause();\n                        player.classList.remove('playing');\n                    }\n                });\n\n                \/\/ Update button state when video plays\/pauses\n                video.addEventListener('play', () => player.classList.add('playing'));\n                video.addEventListener('pause', () => player.classList.remove('playing'));\n            });\n        });\n    <\/script>\n\n\n<\/body>","color_scheme":"","padding_top":40,"padding_bottom":52}}},"order":["collabs","custom_liquid_tPUqaM"]}