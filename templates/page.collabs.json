0%;\n    flex-shrink: 0;\n}\n\n.header-image-credit {\n    position: absolute;\n    bottom: 10px;\n    right: 20px;\n}\n\n.brand-info div h1 {\n    color: white !important;\n}\n\n.image-credit {\n    text-decoration: none;\n    color: #FFF;\n}\n\n\/* Introduction Section *\/\n.intro-section {\n    padding: 30px 20px;\n    background: white;\n    \n}\n\n.intro-content {\n    max-width: 800px;\n    margin: 0 auto;\n}\n\n.intro-text {\n    margin-bottom: 20px;\n}\n\n.intro-actions {\n    display: flex;\n    gap: 15px;\n    align-items: center;\n    flex-wrap: wrap;\n    width: 100%;\n}\n\n.intro-actions img {\n    width: 25px;\n    height: 25px;\n}\n\n.intro-actions .button {\n    margin: 0 auto;\n}\n\n.login-link {\n    margin: 25px auto 0px;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 15px;\n}\n\n\/* Welcome Section *\/\n.welcome-section {\n    padding: 40px 20px;\n    background: white;\n    text-align: center;\n}\n\n.welcome-section h2 {\n    margin-bottom: 30px;\n}\n\n.welcome-gallery {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n    gap: 50px;\n    max-width: 1200px;\n    margin: 0 auto;\n}\n\n.gallery-item {\n    border-radius: 20px;\n    overflow: hidden;\n}\n\n.gallery-item img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n}\n\n\/* Instagram Embed Styling *\/\n.gallery-item .instagram-media,\n.gallery-item iframe {\n    margin: 0 !important;\n    border-radius: 20px !important;\n    min-width: 0 !important;\n    max-width: 100% !important;\n    width: 100% !important;\n}\n\n\/* Custom Video Player *\/\n.gallery-item.video-player {\n    background: #000;\n    aspect-ratio: 9\/16;\n    position: relative;\n    cursor: pointer;\n}\n\n.gallery-item.video-player video {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    border-radius: 20px;\n}\n\n\/* Play\/Pause Button *\/\n.video-play-btn {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%);\n    width: 70px;\n    height: 70px;\n    border-radius: 50%;\n    background: rgba(0, 0, 0, 0.6);\n    border: none;\n    cursor: pointer;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    opacity: 0;\n    transition: opacity 0.3s ease;\n    z-index: 10;\n}\n\n.video-play-btn svg {\n    width: 32px;\n    height: 32px;\n    color: white;\n}\n\n\/* Show button on hover *\/\n.gallery-item.video-player:hover .video-play-btn {\n    opacity: 1;\n}\n\n\/* Show\/hide play and pause icons based on state *\/\n.video-play-btn .pause-icon {\n    display: none;\n}\n\n.video-play-btn .play-icon {\n    display: block;\n}\n\n.gallery-item.video-player.playing .video-play-btn .pause-icon {\n    display: block;\n}\n\n.gallery-item.video-player.playing .video-play-btn .play-icon {\n    display: none;\n}\n\n\/* Video Link Overlay - Bottom 10% *\/\n.video-link-overlay {\n    position: absolute;\n    bottom: 0;\n    left: 0;\n    right: 0;\n    height: 10%;\n    z-index: 15;\n    cursor: pointer;\n    display: block;\n    background: transparent;\n    \/* Ensures the empty anchor is clickable *\/\n    -webkit-tap-highlight-color: transparent;\n}\n\n\n\n\/* Perks Section *\/\n.perks-section {\n    padding: 40px 20px;\n    text-align: center;\n}\n\n.perks-section h2 {\n    margin-bottom: 30px;\n}\n\n.perks-table {\n    max-width: 1200px;\n    margin: 0 auto;\n}\n\n.perks-table img {\n    width: 100%;\n    height: auto;\n    border-radius: 12px;\n}\n\n\/* Looking For Section *\/\n.looking-for-section {\n    padding: 40px 20px;\n    background: white;\n    text-align: center;\n}\n\n.looking-for-section h2 {\n    margin-bottom: 30px;\n}\n\n.looking-for-content {\n    max-width: 800px;\n    margin: 0 auto 30px;\n    display: grid;\n    grid-template-columns: 200px 1fr;\n    gap: 30px;\n    align-items: center;\n    text-align: left;\n}\n\n.profile-image {\n    border-radius: 12px;\n    overflow: hidden;\n}\n\n.profile-image img {\n    width: 100%;\n    height: auto;\n}\n\n\n\/* Community Section *\/\n.community-section {\n    padding: 40px 20px;\n    background: white;\n}\n\n.community-gallery {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n    gap: 20px;\n    max-width: 1200px;\n    margin: 0 auto;\n}\n\n.community-item {\n    text-align: center;\n    text-decoration: none;\n    color: black;\n}\n\n.community-item img {\n    width: 100%;\n    border-radius: 10%;\n    aspect-ratio: 3\/4;\n    object-fit: cover;\n}\n\n.username {\n    margin-top: 10px;\n}\n\n\/* Join Section *\/\n.join-section {\n    padding: 40px 20px;\n    background: white;\n    text-align: center;\n}\n\n.join-section h2 {\n    margin-bottom: 30px;\n}\n\n.social-links {\n    display: flex;\n    justify-content: center;\n    gap: 30px;\n}\n\n.social-icon img {\n    height: 60px;\n}\n\n\/* Perks Section *\/\n.perks-section {\n    width: 100%;\n    padding: 40px 0;\n}\n\n.perks-section img {\n    display: block;\n    width: 100%;\n    max-width: 960px;\n    height: auto;\n    margin: 0 auto;\n    padding: 0 20px;\n    box-sizing: border-box;\n}\n\n\/* Responsive Design *\/\n@media (max-width: 768px) {\n    .collabs-header {\n        padding: 60px 20px;\n        aspect-ratio: auto;\n    }\n\n    .header-content {\n        width: 90%;\n    }\n\n    .brand-logo {\n        flex-direction: column;\n        align-items: center;\n        gap: 15px;\n    }\n\n    .brand-info {\n        flex-direction: column;\n        align-items: center;\n        text-align: center;\n    }\n\n    .brand-logo .logo-img {\n        width: 80px;\n        height: 80px;\n    }\n\n    .page-title {\n        justify-content: center;\n    }\n\n    .page-title img {\n        width: 28px;\n        height: 28px;\n    }\n\n    .intro-actions {\n        gap: 10px;\n    }\n\n    .intro-actions img {\n        width: 20px;\n        height: 20px;\n    }\n\n    .looking-for-content {\n        grid-template-columns: 1fr;\n        text-align: center;\n    }\n\n    .welcome-gallery,\n    .community-gallery {\n        grid-template-columns: 1fr;\n    }\n}\n\n@media (max-width: 480px) {\n    .collabs-header {\n        padding: 50px 20px;\n    }\n\n    .brand-logo .logo-img {\n        width: 70px;\n        height: 70px;\n    }\n\n    .page-title {\n        justify-content: center;\n        align-items: center;\n    }\n\n    .page-title h1 {\n        font-size: 4rem;\n    }\n\n    .page-title img {\n        width: 24px;\n        height: 24px;\n    }\n\n    .header-image-credit {\n        font-size: 10px;\n    }\n\n    .intro-actions {\n        gap: 8px;\n    }\n\n    .intro-actions img {\n        display: none;\n    }\n\n    .profile-image {\n        width: 66%;\n        margin: 0 auto;\n    }\n}\n\n\n<\/style>\n\n\n\n\n\n\n\n\n\n\n<body>\n    <!-- Header Section with Beach Background -->\n    <header class=\"collabs-header\">\n        <div class=\"header-content\">\n            <div class=\"brand-logo\">\n                <img class=\"logo-img\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/coastalcollabs-assets-03.png?v=1768333152\" alt=\"Coastal Film Lab Logo\">\n                <div class=\"brand-info\">\n                    <div class=\"page-title\">\n                        <h1>COLLABS<\/h1>\n                        <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/coastalcollabs-assets-04.png?v=1768333152\" alt=\"Verified Badge\" class=\"verified-badge\"\/>\n                    <\/div>    \n                    <p>@COASTALFILMLAB<\/p>\n                <\/div>\n            <\/div>\n            <div class=\"header-image-credit\">\n                <a class=\"image-credit\" href=\"https:\/\/www.instagram.com\/brandonmunoz\/\" target=\"_blank\">IMAGE BY @brandonmunoz<\/a>\n            <\/div>\n        <\/div>\n    <\/header>\n\n    <!-- Introduction Section -->\n    <section class=\"intro-section\">\n        <div class=\"intro-content\">\n  