{"sections":{"rich_text_fLCR4r":{"type":"rich-text","blocks":{"heading_DRFcX9":{"type":"heading","settings":{"heading":"Film Developing & Cameras for the Modern Film Photographer","heading_size":"h2"}},"text_mKfpUz":{"type":"text","settings":{"text":"<p>We are a one-stop shop for all things analog. Whether you need film developing, a new film camera, camera maintenence, or family photo digitizing, <br\/>Coastal is keeping film photography current.<\/p>"}},"button_H7HyMP":{"type":"button","settings":{"button_label":"FILM PROCESSING","button_link":"shopify:\/\/pages\/film-development","button_style_secondary":false,"button_label_2":"BUY FILM","button_link_2":"shopify:\/\/pages\/buy-film","button_style_secondary_2":true}}},"block_order":["heading_DRFcX9","text_mKfpUz","button_H7HyMP"],"settings":{"desktop_content_position":"center","content_alignment":"center","color_scheme":"","full_width":true,"padding_top":0,"padding_bottom":0}},"custom_liquid_TdFD4p":{"type":"custom-liquid","settings":{"custom_liquid":"<style>\n    .popular-services-container {\n        max-width: 1400px;\n        margin: auto;\n        padding: 2rem 1rem;\n    }\n\n    .popular-services-grid {\n        display: grid;\n        grid-template-columns: repeat(4, 1fr);\n        gap: 1rem;\n        max-width: 1400px;\n        margin: auto;\n    }\n\n    .popular-service-card {\n        display: flex;\n        flex-direction: column;\n        max-width: min(275px, 100%);\n        gap: 0.75rem;\n        margin: auto;\n        height: 100%;\n    }\n\n    .popular-service-image-link {\n        display: block;\n        width: 100%;\n        aspect-ratio: 1;\n        border-radius: 8px;\n        overflow: hidden;\n    }\n\n    .popular-service-image {\n        width: 100%;\n        height: 100%;\n        object-fit: cover;\n        display: block;\n    }\n\n    \/* Enforced 40% larger single-line title size *\/\n    .popular-service-card h3 {\n        margin: 0;\n        line-height: 1.2;\n        white-space: nowrap;\n        letter-spacing: -0.03em;\n        font-size: clamp(1.9rem, 2.8vw, 2.3rem);\n    }\n\n    .popular-service-card h3 a {\n        display: block;\n        width: 100%;\n        overflow: hidden;\n        text-overflow: ellipsis;\n    }\n\n    .popular-service-description {\n        height: fit-content;\n        margin: 0;\n    }\n\n    \/* Pushes CTA button to bottom of card *\/\n    .popular-service-card .button {\n        margin-top: auto;\n    }\n\n    @media (max-width: 1024px) {\n        .popular-services-grid {\n            grid-template-columns: repeat(2, 1fr);\n        }\n\n        .popular-service-card {\n            max-width: min(300px, 100%); \n            margin: 1rem auto;\n        }\n\n        .popular-service-card h3 {\n            font-size: clamp(1.95rem, 3.5vw, 2.45rem);\n        }\n    }\n\n    @media (max-width: 600px) {\n        .popular-services-grid {\n            grid-template-columns: 1fr;\n        }\n\n        .popular-service-card {\n            max-width: 90%;\n            margin: 1rem auto;\n        }\n\n        .popular-service-card h3 {\n            font-size: 2.1rem;\n        }\n    }\n<\/style>\n\n<div class=\"popular-services-container\">\n    <h2 class=\"title inline-richtext h1\">\n        Popular Services\n    <\/h2>\n    <div class=\"popular-services-grid scroll-trigger animate--slide-in\">\n        \n        <!-- 1. Film Processing -->\n        <div class=\"popular-service-card\">\n            <a class=\"popular-service-image-link\" href=\"https:\/\/www.coastalfilmlab.com\/pages\/film-development\" target=\"_blank\" rel=\"noopener noreferrer\">\n                <img class=\"popular-service-image\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/StandardC41Develop_Scan001_-_2x3_3acc9e36-f0ad-4e44-84a1-758d0913f1db.jpg?v=1726952872\" alt=\"Film Processing\" \/>\n            <\/a>\n            <h3 class=\"inline-richtext\">\n                <a href=\"https:\/\/www.coastalfilmlab.com\/pages\/