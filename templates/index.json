cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/Camera_Repair002.jpg?v=1715982783\" alt=\"Camera Care\" \/>\n            <\/a>\n            <h3 class=\"inline-richtext\">\n                <a href=\"https:\/\/www.coastalfilmlab.com\/pages\/camera-repair\" target=\"_blank\" rel=\"noopener noreferrer\">\n                    Camera Care\n                <\/a>\n            <\/h3>\n            <p class=\"popular-service-description\">\n                Targeted care like light seals, cleanings, and troubleshooting. We're in your corner to help you make the best move with your gear.\n            <\/p>\n            <a class=\"service-link button button--primary\" href=\"https:\/\/www.coastalfilmlab.com\/pages\/camera-repair\" target=\"_blank\" rel=\"noopener noreferrer\">\n                Learn More\n            <\/a>\n        <\/div>\n\n        <!-- 4. Camera Store -->\n        <div class=\"popular-service-card\">\n            <a class=\"popular-service-image-link\" href=\"https:\/\/www.coastalfilmlab.com\/pages\/cameras\" target=\"_blank\" rel=\"noopener noreferrer\">\n                <img class=\"popular-service-image\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/Camera_LensesCover.jpg?v=1718398139\" alt=\"Camera Store\" \/>\n            <\/a>\n            <h3 class=\"inline-richtext\">\n                <a href=\"https:\/\/www.coastalfilmlab.com\/pages\/cameras\" target=\"_blank\" rel=\"noopener noreferrer\">\n                    Camera Store\n                <\/a>\n            <\/h3>\n            <p class=\"popular-service-description\">\n                Film & Digital cameras, lenses, and accessories. Whether you are a beginner or a pro, we have something you will love!\n            <\/p>\n            <a class=\"service-link button button--primary\" href=\"https:\/\/www.coastalfilmlab.com\/pages\/cameras\" target=\"_blank\" rel=\"noopener noreferrer\">\n                Shop Now\n            <\/a>\n        <\/div>\n\n    <\/div>\n<\/div>","color_scheme":"","padding_top":40,"padding_bottom":0}},"multicolumn_qRL6Dq":{"type":"multicolumn","blocks":{"column_KDQdQy":{"type":"column","settings":{"image":"shopify:\/\/shop_images\/StandardC41Develop_Scan001_-_2x3_7398ea00-8608-4b5c-8371-924cdb2b428b.jpg","title":"<a href=\"\/pages\/film-processing\" title=\"Film Processing\">Film Processing<\/a>","text":"<p><strong>Film Types:<\/strong> Color Negative C-41, Black and White, E6 Slide, and ECN-2<br\/><br\/><strong>Film Sizes:<\/strong> Disposable Camera, 35mm Film, 120 Film, 220 Film, 110 Film, APS, 4x5 Film <\/p>","link_label":"Order","link":"shopify:\/\/pages\/film-development"}},"column_g9tRUV":{"type":"column","settings":{"image":"shopify:\/\/shop_images\/Buy_Film_4x6-01.jpg","title":"<a href=\"\/pages\/photographic-film\" title=\"Buy Film\">Buy Film<\/a>","text":"<p><strong>Film Stocks: <\/strong>Kodak, Fujifilm, Ilford, Lomography, CineStill, and Polaroid<br\/><br\/><strong>Film Types:<\/strong> Color, Black & White, Instant, 4x5 Format, and 35mm Motion Picture Film<\/p>","link_label":"Shop Now","link":"shopify:\/\/pages\/buy-film"}},"column_7qF7NQ":{"type":"column","settings":{"image":"shopify:\/\/shop_images\/Camera_Repair001.jpg","title":"<a href=\"\/pages\/camera-repair\" title=\"Camera Repair\">Camera Repair<\/a>","text":"<p><strong>Diagnostics: <\/strong>A Non-refundable<strong> <\/strong>$100 diagnostics that goes towards the final repair cost will get you started in finding out what it would take to fully repair your camera<br\/><strong><br\/>Clean and Seal:  <\/strong>A $50 Basic cleaning and replacement of light seals for any camera.<\/p>","link_label":"Order","link":"shopify:\/\/pages\/camera-repair"}},"column_ejneeB":{"type":"column","settings":{"image":"shopify:\/\/shop_images\/Camera_LensesCover.jpg","title":"<a href=\"\/pages\/cameras\" title=\"Cameras & Lenses\">Cameras & Lenses<\/a>","text":"<p><strong>Cameras:<\/strong> Explore our range of film cameras designed for all levels of expertise.<\/p><p><strong>Lenses: <\/strong>Discover our lineup of Lenses for different camera mounts.<\/p>","link_label":"Shop now","link":"shopify:\/\/pages\/cameras"}}},"block_order":["column_KDQdQy","column_g9tRUV","column_7qF7NQ","column_ejneeB"],"disabled":true,"custom_css":[".link {padding: 13px 26px; background-color: #f2bb78; border-radius: 3px; color: black; border-color: #f2bb78; letter-spacing: 0.15em; text-transform: uppercase; font-weight: 500; font-size: 12px;}"],"settings":{"title":"Popular Services","heading_size":"h1","image_width":"full","image_ratio":"square","columns_desktop":4,"column_alignment":"left","background_style":"none","button_label":"","button_link":"","color_scheme":"","columns_mobile":"1","swipe_on_mobile":false,"padding_top":36,"padding_bottom":36}},"custom_liquid_QTfb6Y":{"type":"custom-liquid","disabled":true,"name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<style>\n\n        :root {\n            --film-strip-bg: url('https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/filmstrip-ticker.png?v=1745420345');\n        }\n\n        .container {\n            display: flex;\n            flex-direction: column;\n            justify-content: center;\n            align-items: center;\n            width: 100%;\n            overflow: hidden;\n            max-height: 95vh;\n        }\n\n        .ticker-wrapper {\n            overflow: hidden;\n            width: 100%;\n            position: relative;\n        }\n\n        .ticker-content {\n            display: flex;\n            transition: transform 0.7s ease;\n            will-change: transform;\n            margin: 0px;\n        }\n\n        \n        .film-strip {\n            position: relative;\n            background-size: contain;  \/* Ensures the entire image fits inside the ticker-wrapper *\/\n            background-repeat: no-repeat;  \/* Prevents the image from repeating *\/\n            background-position: center;  \/* Centers the background image *\/\n            aspect-ratio: 3 \/ 1;  \/* Adjust the ratio as needed to maintain image proportions *\/\n            display: flex;\n            flex-direction: row;\n            justify-content: space-around;\n            align-items: center;\n            background-image: var(--film-strip-bg);\n            height: 50vh;\n            max-height: 375px;\n        }\n\n        .frame {\n            display: flex;\n            align-items: center;\n            flex: 0 0 auto; \/* Prevents the frame from growing or shrinking *\/\n            justify-content: center;\n            \/* Cap width by viewport height; also keep it from overflowing viewport width *\/\n            width: 90vw;\n            max-width: 100%;\n            background-size: cover;\n            background-repeat: no-repeat;\n            background-position: center;\n            aspect-ratio: 5\/3;\n        }\n\n        img {\n            border-radius: 3px;\n            max-width: 98%;\n            height: auto;\n        }\n        \n        .section-title {\n            font-size: 5rem;\n            text-align: center;\n            margin: 0 auto;\n        }\n\n        .controls {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            margin-top: 15px;\n            gap: 50px;\n        }\n\n        .controls button img {\n            transition: transform 0.1s ease;\n        }\n\n        .controls button:active img {\n            transform: translateY(2px); \/* Moves down *\/\n        }\n\n        .controls button:hover img {\n            cursor: pointer;\n        }\n\n        .controls button.keyboard-active img {\n            transform: translateY(2px);\n        }\n\n\n        \/* Image fills the frame *\/\n        .frame > img {\n        display: block;\n        width: 100%;\n        height: auto;\n        border-radius: 3px;\n        }\n\n        \/* (Optional) Keep your press-down effect *\/\n        .controls button img {\n        transition: transform 0.1s ease;\n        }\n        .controls button:active img {\n\n        transform: scale(0.80);\n        }\n        .controls button:hover img {\n        cursor: pointer;\n        }\n        \n        @media screen and (min-width: 599px) {\n            .frame {\n                max-width: 421px;\n            }\n        }\n\n    <\/style>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<body>\n    <div class=\"container\">\n        <h2 class=\"section-title\">Landscapes in Emulsion<\/h2>\n        <div class=\"ticker-wrapper\">\n            <div class=\"ticker-content\">\n              <!-- film-strip elements go here -->\n            <\/div>\n          <\/div>\n        <\/div>\n        <div class=\"controls\">\n            <button id=\"scroll-left\" style=\"background:none; border:none; padding:25px;\">\n                <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/ScannerButtonLeft.png?v=1754933785\" alt=\"Scroll Left\" style=\"width:100px; height:auto;\">\n            <\/button>\n            <button id=\"scroll-right\" style=\"background:none; border:none; padding:25px;\">\n                <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/ScannerButtonRight.png?v=1754933786\" alt=\"Scroll Right\" style=\"width:100px; height:auto;\">\n            <\/button>\n        <\/div>\n    <\/div>\n    \n\n    <script>\n        const images = [\n            'https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/000159810008_1_Large_3b1f1547-b0b7-4bc9-8750-5c3eade8ce28.jpg?v=1755113880',\n            'https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/000128890007_Large_db8c8ff1-65b8-41ba-9046-bdb8f25527fa.jpg?v=1755114408',\n            'https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/SCR-20250814-c7l.jpg?v=1755175807',\n            'https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/000128860001.jpg?v=1755114572',\n            'https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/CF-Landscapes-6.jpg?v=1758052696',\n            'https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/CF-Landscapes-15.jpg?v=1758052393',\n            'https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/CF-Landscapes-12.jpg?v=1758052519',\n            'https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/CF-Landscapes-4.jpg?v=1758052185',\n        ]\n\n        const usedImageIndex= []; \/\/ Array to keep track of used images\n        const size = 4; \/\/ Number of images to display in the film strip\n\n        function makeStrip() {\n            const tickerContent = document.querySelector('.ticker-content');\n\n            const filmStrip = document.createElement('div');\n            filmStrip.classList.add('film-strip');\n\n            images.forEach((image, i) => {\n                const frame = document.createElement('div');\n                frame.classList.add('frame');\n\n                const imgTag = document.createElement('img');\n                imgTag.src = image;\n                imgTag.alt = `Frame ${i + 1}`;\n\n                frame.appendChild(imgTag);\n                filmStrip.appendChild(frame);\n            });\n            tickerContent.appendChild(filmStrip);\n        }\n\n        makeStrip();\n\n        \/\/ Calculate the width of the film strip\n        const filmStrip = document.querySelector('.film-strip');\n        const filmStripWidth = filmStrip.offsetWidth;\n        const screenWidth = window.innerWidth;\n\n        const rightStop = filmStripWidth - screenWidth;\n\n        function scrollRight() {\n            if (currentPosition > -rightStop) {  \n                currentPosition -= shiftAmount;\n                content.style.transform = `translateX(${currentPosition}px)`;\n            }\n        }\n\n        function scrollLeft() {\n            if (currentPosition < 0) {\n                currentPosition += shiftAmount;\n                content.style.transform = `translateX(${currentPosition}px)`;\n            }\n        }\n\n        let currentPosition = 0;\n\n        \/\/ const shiftAmount = 100; \/\/ Adjust this value to control the scroll amount\n        \/\/ shiftAmount = the width of one frame plus some margin\n        const frame = document.querySelector('.frame');\n        const frameStyle = window.getComputedStyle(frame);\n        const frameWidth = frame.offsetWidth;\n        const frameMarginRight = parseInt(frameStyle.marginRight) || 0;\n        const shiftAmount = (frameWidth + frameMarginRight) \/ 4.02; \/\/ Scroll by a quarter of frame width\n\n\n        const content = document.querySelector('.ticker-content');\n        const scrollLeftButton = document.getElementById('scroll-left');\n        const scrollRightButton = document.getElementById('scroll-right');\n\n        scrollLeftButton.addEventListener('click', () => {\n            scrollLeft();\n        });\n        scrollRightButton.addEventListener('click', () => {\n            scrollRight();\n        });\n\n        let scrollInterval;\n\n        function startScrolling(direction) {\n            scrollInterval = setInterval(() => {\n                if (direction === 'left') {\n                    scrollLeft();\n                } else {\n                    scrollRight();\n                }\n            }, 250); \/\/ Adjust interval speed here (ms between shifts)\n        }\n\n        function stopScrolling() {\n            clearInterval(scrollInterval);\n        }\n\n        \/\/ Left button\n        scrollLeftButton.addEventListener('mousedown', () => startScrolling('left'));\n        scrollLeftButton.addEventListener('mouseup', stopScrolling);\n        scrollLeftButton.addEventListener('mouseleave', stopScrolling);\n\n        \/\/ Right button\n        scrollRightButton.addEventListener('mousedown', () => startScrolling('right'));\n        scrollRightButton.addEventListener('mouseup', stopScrolling);\n        scrollRightButton.addEventListener('mouseleave', stopScrolling);\n\n\n\n        \/\/ Helper to check if container is mostly in viewport\n        function isContainerMostlyInView() {\n            const container = document.querySelector('.container');\n            if (!container) return false;\n            const rect = container.getBoundingClientRect();\n            const viewportHeight = window.innerHeight || document.documentElement.clientHeight;\n            const viewportWidth = window.innerWidth || document.documentElement.clientWidth;\n            const containerArea = rect.width * rect.height;\n            const visibleWidth = Math.max(0, Math.min(rect.right, viewportWidth) - Math.max(rect.left, 0));\n            const visibleHeight = Math.max(0, Math.min(rect.bottom, viewportHeight) - Math.max(rect.top, 0));\n            const visibleArea = visibleWidth * visibleHeight;\n            return (visibleArea \/ containerArea) >= 0.5; \/\/ 50% or more visible\n        }\n\n        \/\/ Keyboard arrow control with hold + visual active state\n        let leftHeld = false;\n        let rightHeld = false;\n        let keyHoldTimeout = null; \/\/ delay before continuous scrolling starts\n\n        document.addEventListener('keydown', (e) => {\n            if (!isContainerMostlyInView()) return;\n\n            \/\/ Ignore when typing in inputs\/textareas\/contenteditable elements\n            const tag = (e.target && e.target.tagName) ? e.target.tagName.toLowerCase() : '';\n            if (tag === 'input' || tag === 'textarea' || (e.target && e.target.isContentEditable)) return;\n\n            if (e.key === 'ArrowLeft') {\n                e.preventDefault();\n                if (leftHeld) return; \/\/ ignore auto-repeat\n                leftHeld = true;\n                scrollLeftButton.classList.add('keyboard-active');\n\n                \/\/ Single step immediately (like a tap)\n                scrollLeft();\n\n                \/\/ Start continuous scrolling after a short hold\n                keyHoldTimeout = setTimeout(() => {\n                    startScrolling('left');\n                }, 250);\n            } else if (e.key === 'ArrowRight') {\n                e.preventDefault();\n                if (rightHeld) return; \/\/ ignore auto-repeat\n                rightHeld = true;\n                scrollRightButton.classList.add('keyboard-active');\n\n                \/\/ Single step immediately (like a tap)\n                scrollRight();\n\n                \/\/ Start continuous scrolling after a short hold\n                keyHoldTimeout = setTimeout(() => {\n                    startScrolling('right');\n                }, 250);\n            }\n        });\n\n        document.addEventListener('keyup', (e) => {\n            if (e.key === 'ArrowLeft' && leftHeld) {\n                leftHeld = false;\n                scrollLeftButton.classList.remove('keyboard-active');\n                if (keyHoldTimeout) { clearTimeout(keyHoldTimeout); keyHoldTimeout = null; }\n                stopScrolling();\n            } else if (e.key === 'ArrowRight' && rightHeld) {\n                rightHeld = false;\n                scrollRightButton.classList.remove('keyboard-active');\n                if (keyHoldTimeout) { clearTimeout(keyHoldTimeout); keyHoldTimeout = null; }\n                stopScrolling();\n            }\n        });\n\n    <\/script>\n<\/body>","color_scheme":"","padding_top":40,"padding_bottom":52}},"featured_blog_YBrFAD":{"type":"featured-blog","disabled":true,"settings":{"heading":"Coastal Film Lab News","heading_size":"h1","blog":"news","post_limit":3,"columns_desktop":3,"color_scheme":"","show_image":true,"show_date":true,"show_author":false,"show_view_all":true,"padding_top":36,"padding_bottom":36}},"featured_collection_gLyWMK":{"type":"featured-collection","custom_css":[".card__content {display: flex; flex-direction: column; align-items: center; justify-content: space-between; width: 100%;}",".card__information {margin: 0;}"],"settings":{"title"