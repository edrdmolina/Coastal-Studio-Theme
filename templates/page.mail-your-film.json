    "steps": {
      "type": "cfl-mail-in-steps",
      "blocks": {
        "s1": {
          "type": "step",
          "settings": {
            "title": "Order online",
            "text": "<p>Pick your film and scan size, and choose what happens to your negatives.</p>"
          }
        },
        "s2": {
          "type": "step",
          "settings": {
            "title": "Send your film",
            "text": "<p>Add a prepaid label (from $9.99) and we email you a link to make it. No printer? Pick UPS and any UPS Store can print it. Or ship it yourself with any carrier.</p>"
          }
        },
        "s3": {
          "type": "step",
          "settings": {
            "title": "Get your scans",
            "text": "<p>We email a private Google Drive link, live for a year. Negatives come back for $9.99, free on orders of $100 or more. Don't need them? We discard them and there's no return shipping.</p>"
          }
        }
      },
      "block_order": [
        "s1",
        "s2",
        "s3"
      ],
