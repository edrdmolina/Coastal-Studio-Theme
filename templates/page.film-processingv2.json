{"sections":{"main":{"type":"main-page","disabled":true,"settings":{"padding_top":28,"padding_bottom":28}},"image_banner_FVNpH9":{"type":"image-banner","blocks":{"heading_kTHMHW":{"type":"heading","disabled":true,"settings":{"heading":"Film Processing","heading_size":"h0"}},"text_w8MWfd":{"type":"text","disabled":true,"settings":{"text":"We process and scan C-41 and B&W Film daily, delivering scans via Google Drive. In addition, we offer E-6 and ECN-2 Developing services. Our Standard Turnaround time is about 7 Business Days with 1-Day and 3-Day Rushes. E-6 and ECN-2 Processing times vary","text_style":"body"}},"buttons_Gdwpqa":{"type":"buttons","disabled":true,"settings":{"button_label_1":"Develop & Scan","button_link_1":"shopify:\/\/collections\/develop-and-scan","button_style_secondary_1":false,"button_label_2":"Develop Only","button_link_2":"shopify:\/\/collections\/develop-only","button_style_secondary_2":true}}},"block_order":["heading_kTHMHW","text_w8MWfd","buttons_Gdwpqa"],"custom_css":[".button {padding: 6px;}"],"settings":{"image":"shopify:\/\/shop_images\/SOCIALMEDI008383-R1-001_Large_59549383-4997-4143-8f57-4c0380d58b32.jpg","image_overlay_opacity":0,"image_height":"medium","desktop_content_position":"bottom-center","show_text_box":true,"desktop_content_alignment":"center","color_scheme":"inverse","image_behavior":"none","mobile_content_alignment":"center","stack_images_on_mobile":false,"show_text_below":true}},"rich_text_jD4mRm":{"type":"rich-text","blocks":{"heading_6E7bRg":{"type":"heading","settings":{"heading":"Film Processing","heading_size":"h1"}},"text_KWqeU9":{"type":"text","settings":{"text":"<p>We process and scan C-41 and B&W Film daily, delivering scans via Google Drive. In addition, we offer E-6 and ECN-2 Developing services. Our current Turnaround time is kept updated on the banner above. We offer 1-Day and 3-Day Rushes when needed. E-6 and ECN-2 Processing times vary<\/p>"}},"button_DJMXT4":{"type":"button","settings":{"button_label":"Develop & Scan","button_link":"shopify:\/\/collections\/develop-and-scan","button_style_secondary":false,"button_label_2":"Develop Only","button_link_2":"shopify:\/\/collections\/develop-only","button_style_secondary_2":true}}},"block_order":["heading_6E7bRg","text_KWqeU9","button_DJMXT4"],"custom_css":[".button {padding: 6px;}"],"name":"t:sections.rich-text.presets.name","settings":{"desktop_content_position":"center","content_alignment":"center","color_scheme":"","full_width":true,"padding_top":40,"padding_bottom":52}},"custom_liquid_UDC7GB":{"type":"custom-liquid","settings":{"custom_liquid":"<style>\n    :root {\n        --film-strip-bg: url('https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/positive-services-filmstrip.png?v=1738872849');\n        --film-strip-bg-mobile: url('https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/positive-services-filmstripPhone.png?v=1740421057');\n    }\n\n    .container {\n        display: flex;\n        flex-direction: row;\n        justify-content: center;\n    }\n\n    .film-strip {\n        position: relative;\n        background-size: contain;  \/* Ensures the entire image fits inside the container *\/\n        background-repeat: no-repeat;  \/* Prevents the image from repeating *\/\n        background-position: center;  \/* Centers the background image *\/\n        aspect-ratio: 3 \/ 1;  \/* Adjust the ratio as needed to maintain image proportions *\/\n        display: flex;\n        flex-direction: row;\n        justify-content: space-around;\n        align-items: center;\n        width: 90%;\n        background-image: var(--film-strip-bg);\n    }\n    \n    .frame {\n        height: 43%;\n        background-size: cover;\n        background-repeat: no-repeat;\n        background-position: center;\n        aspect-ratio: 5\/3;\n        max-width: fit-content;\n    }\n\n    .frame:hover {\n        transform: scale(1.01);\n    }\n\n    img {\n        border-radius: 3px;\n        max-width: 100%;\n        height: auto;\n    }\n\n    @media (max-width: 768px) {\n        .film-strip {\n            flex-direction: column;\n\n            aspect-ratio: 1\/3;\n            background-image: var(--film-strip-bg-mobile);\n        }\n\n        .frame {\n            aspect-ratio: 3\/5;\n            max-width: 70%;\n            height: 24%;\n        }\n\n    }\n\n<\/style>\n\n\n\n<div id=\"get-started\" class=\"container scroll-trigger animate--slide-in\">\n    <div class=\"film-strip\">\n        <a class=\"frame\">\n            <img src=\"\" alt=\"\">\n        <\/a>\n        <a class=\"frame\">\n            <img src=\"\" alt=\"\">\n        <\/a>\n        <a class=\"frame\">\n            <img src=\"\" alt=\"\">\n        <\/a>\n        <a class=\"frame\">\n            <img src=\"\" alt=\"\">\n        <\/a>\n    <\/div>\n<\/div>\n\n\n\n<script>\n    const developAndScan = {\n        link: 'https:\/\/www.coastalfilmlab.com\/collections\/develop-and-scan',\n        positiveLandscapeImageSrc: 'https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/Dev_ScanAllFilmPos_Medium_580cd73c-d461-4684-ad4b-a423bd0d6d20.png?v=1745600067',\n        positivePortraitImageSrc: 'https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/DevAndScanAllFilmPhone.png?v=1740419675',\n        negativeImageSrc: ''\n    }\n\n    const developOnly = {\n        link: 'https:\/\/www.coastalfilmlab.com\/collections\/develop-only',\n        positiveLandscapeImageSrc: 'https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/DevOnlyPos.png?v=1745600020',\n        positivePortraitImageSrc: 'https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/DevOnlyPhone.png?v=1740419675',\n        negativeImageSrc: ''\n    }\n\n    const developAndScan135 = {\n        link: 'https:\/\/www.coastalfilmlab.com\/products\/develop-and-scan-35mm-c41',\n        positiveLandscapeImageSrc: 'https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/Dev_Scan135Pos_Medium_a8fccdf7-3bda-4302-b883-6e0f838e14c1.png?v=1745600067',\n        positivePortraitImageSrc: 'https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/DevAndScan135Phone.png?v=1740419674',\n        negativeImageSrc: '',\n    }\n\n    const developAndScanDisposable = {\n        link: 'https:\/\/www.coastalfilmlab.com\/products\/develop-and-scan-disposable',\n        positiveLandscapeImageSrc: 'https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/Dev_ScanDispoPos_f8af88c1-a235-41d9-992b-c181b453f1d6.png?v=1745600021',\n        positivePortraitImageSrc: 'https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/DevAndScanDispoPhone.png?v=1740419674',\n        negativeImageSrc: '',\n    }\n    \n    \/\/ THIS IS THE ORDER OF HOW THEY SHOW UP ON SCREEN\n    const sources = [developAndScan135, developAndScan, developOnly, developAndScanDisposable]\n\n    const filmStripLandscapeNegative = 'https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/negative-services-filmstrip.png?v=1738872849';\n    const filmStripLandscapePositive = 'https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/positive-services-filmstrip.png?v=1738872849';\n    const filmStripPortraitPositive = 'https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/positive-services-filmstripPhone.png?v=1740421057'\n\n    const filmStrip = document.querySelector('.film-strip');\n    const frames = document.querySelectorAll('.frame');\n    let screenWidth = window.innerWidth;\n\n\n    function makeNegative() {\n        frames.forEach((f, i) => {\n            f.href = sources[i].link;\n            f.querySelector('img').src = sources[i].negativeImageSrc;\n        })\n    }\n\n    function makePositive() {\n        frames.forEach((f, i) => {\n            f.href = sources[i].link;\n            if (screenWidth <= 768) {\n                f.querySelector('img').src = sources[i].positivePortraitImageSrc;\n            } else {\n                f.querySelector('img').src = sources[i].positiveLandscapeImageSrc;\n            }\n        })\n    }\n\n    makePositive();\n\n    window.addEventListener('resize', () => {\n        screenWidth = window.innerWidth;\n        makePositive();\n    })\n\n<\/script>","color_scheme":"","padding_top":40,"padding_bottom":52}},"custom_liquid_GzAWMJ":{"type":"custom-liquid","settings":{"custom_liquid":"<style>\n        .container {\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            justify-content: center;\n        }\n\n        .steps {\n            display: flex;\n            flex-direction: row;\n            justify-content: space-around;\n            align-items: stretch;\n            width: 100%;\n            flex-wrap: wrap;\n            margin-bottom: 50px;\n        }\n    \n        .step {\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            max-width: 20%;\n            text-align: center;\n            padding: 20px;\n            border-radius: 10px;\n            background-color: #fffcf5;\n            background-color: #fff7f0;\n            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);\n            transition: transform 0.3s, box-shadow 0.3s;\n            flex-grow: 1;\n        }\n    \n        .step:hover {\n            transform: translateY(-10px);\n            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);\n        }\n    \n        .step-icon {\n            margin-bottom: 10px;\n            width: 45%;\n            color: #4CAF50; \/* Change this color to your desired icon color *\/\n        }\n    \n        .step-title {\n            font-size: 18px;\n            font-weight: bold;\n            margin-bottom: 10px;\n            color: #333333;\n        }\n    \n        .step-description {\n            color: #666666;\n        }\n\n        @media screen and (max-width: 1000px) {\n            .step {\n                min-width: 40%;\n                margin-top: 25px;\n            }\n            \n        }\n\n        @media screen and (max-width: 600px) {\n            .step {\n                min-width: 75%;\n                margin-top: 25px;\n            }\n        }\n    <\/style>\n\n\n\n\n\n\n   <div class=\"container scroll-trigger animate--slide-in\">\n        <h1>\n            How This Works\n        <\/h1>\n\n        <div class=\"steps\">\n            <div class=\"step step-one\">\n                <img class=\"step-icon\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/OrderFormGraphic-FilmProcessing.png?v=1746547700\" alt=\"\"\/>\n                <div class=\"step-title\">Step 1<\/div>\n                <div class=\"step-description\">Create an online order by following the film strip above and write your name and <strong>order number<\/strong> found in your confirmation email on a piece of paper.<\/div>\n            <\/div>\n            <div class=\"step step-two\">\n                <img class=\"step-icon\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/ShippingBoxGraphic-FilmProcessing.png?v=1746547700\" alt=\"\"\/>\n                <div class=\"step-title\">Step 2<\/div>\n                <div class=\"step-description\">\n                    For <strong>Mail-In Orders<\/strong>, please place your order # and film in a box or padded envelope. Avoid paper envelopes and please save your tracking number.\n                <\/div>\n            <\/div>\n            <div class=\"step step-three\">\n                <img class=\"step-icon\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/MailBoxGraphic-FilmProcessing.png?v=1746547700\" alt=\"\"\/>\n                <div class=\"step-title\">Step 3<\/div>\n                <div class=\"step-description\">\n                    Mail your order through your local post office, or drop it off at our location in:<br>\n                    1704 N Nebraska Ave, Tampa, FL 33602.<br><br>\n                    P.S. There is a drop-box between our two front doors.\n                <\/div>\n            <\/div>\n            <div class=\"step step-four\">\n                <img class=\"step-icon\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0585\/6093\/8038\/files\/135CartridgeGraphic-FilmProcessing.png?v=1746547700\" alt=\"\"\/>\n                <div class=\"step-title\">Step 4<\/div>\n                <div class=\"step-description\">\n                    Give us about 7 Business days to process your order. <br>\n                    You will receive an email with a Google Drive Link to your scans and a notification of when your negatives and or prints have shipped.\n                <\/div>\n            <\/div>\n        <\/div>\n\n        <a href=\"#get-started\" role=\"link\" class=\"button button--primary\">\n            Get Started\n        <\/a>\n    <\/div>","color_scheme":"","padding_top":40,"padding_bottom":52}},"image_with_text_LXYHRr":{"type":"image-with-text","blocks":{"heading_i9cVxk":{"type":"heading","settings":{"heading":"Develop & Scan","heading_size":"h1"}},"text_t8PrMW":{"type":"text","settings":{"text":"<p>Our <strong>Develop & Scan service<\/strong> offers expert film processing and high-quality scanning, ensuring your photos are preserved with care and precision.<\/p><p><strong>What We Offer:<\/strong><\/p><p>\t•\t<strong>Professional Development:<\/strong> We carefully process C-41 color, black & white, E-6 slide, and ECN-2 motion picture films with consistent and reliable results.<\/p><p>\t•\t<strong>Professional Scanning:<\/strong> Each frame is individually color-corrected to provide accurate tones and beautiful results that stay true to your film’s unique character.<\/p><p>\t•\t<strong>Easy Digital Access:<\/strong> After processing, your scans are quality-checked and securely uploaded to Google Drive for convenient downloading.<\/p><p>\t•\t<strong>Flexible Negative Returns:<\/strong> Get your negatives returned either rolled up or cut and sleeved for easy storage.<br\/><\/p>","text_style":"body"}},"button_9WdrCP":{"type":"button","settings":{"button_label":"Develop & Scan","button_link":"shopify:\/\/collections\/develop-and-scan","button_style_secondary":false}}},"block_order":["heading_i9cVxk","text_t8PrMW","button_9WdrCP"],"settings":{"image":"shopify:\/\/shop_images\/CFL2024-FilmProcessing00009-WebSize004.jpg","height":"adapt","desktop_image_width":"medium","layout":"image_first","desktop_content_position":"top","desktop_content_alignment":"left","content_layout":"no-overlap","section_color_scheme":"","color_scheme":"","image_behavior":"none","mobile_content_alignment":"left","padding_top":36,"padding_bottom":36}},"image_with_text_za6MBJ":{"type":"image-with-text","blocks":{"heading_Uz4dLX":{"type":"heading","settings":{"heading":"Develop Only","heading_size":"h1"}},"text_Km8TEh":{"type":"text","settings":{"text":"<p>Our <strong>Develop Only service<\/strong> provides professional film processing using industry-leading equipment to ensure your negatives are developed with the utmost care and accuracy. Whether you’re shooting color, black & white, or specialty films, we handle each roll with precision to preserve your memories for years to come.<\/p><p><br\/><\/p><p><strong>What We Offer:<\/strong><\/p><p>\t•\t<strong>Professional Development:<\/strong><\/p><p>\t•\t<strong>C-41 Color & Black & White Film:<\/strong> Processed using a <strong>roller transport processor<\/strong>, ensuring smooth and consistent results across every frame.<\/p><p>\t•\t<strong>E-6 Slide & ECN-2 Motion Picture Film:<\/strong> Developed with our <strong>Jobo ATL 2000<\/strong>, delivering precise chemical control for stunning clarity and color accuracy.<\/p><p>\t•\t<strong>Careful Handling:<\/strong> Our experienced technicians monitor each stage of the process to guarantee optimal results and handle your film with the highest level of care.<\/p><p>\t•\t<strong>Flexible Negative Returns:<\/strong> We offer two options for returning your developed film—<strong>rolled up<\/strong> for compact storage or <strong>cut and sleeved<\/strong> for easy organization and archiving.<\/p>","text_style":"body"}},"button_KAQMyc":{"type":"button","settings":{"button_label":"Develop Only","button_link":"shopify:\/\/collections\/develop-only","button_style_secondary":false}}},"block_order":["heading_Uz4dLX","text_Km8TEh","button_KAQMyc"],"settings":{"image":"shopify:\/\/shop_images\/WebsitePhotos-060.jpg","height":"adapt","desktop_image_width":"medium","layout":"text_first","desktop_content_position":"top","desktop_content_alignment":"left","content_layout":"no-overlap","section_color_scheme":"","color_scheme":"","image_behavior":"none","mobile_content_alignment":"left","padding_top":36,"padding_bottom":36}},"image_with_text_YxtnnM":{"type":"image-with-text","blocks":{"heading_JMKjj7":{"type":"heading","settings":{"heading":"Is your film already developed?","heading_size":"h1"}},"text_CKHTCn":{"type":"text","settings":{"text":"<p>Already have your negatives developed? Our <strong>Scan-Only Film Service<\/strong> is built just for you. You don’t need film development; just trusted, high-quality digitization. Whether you’re a photographer looking to preserve your recent shoots or a hobbyist with fresh rolls ready for archiving, we’ll convert your developed 35 mm, 120\/220, APS, and other formats into crisp, high-resolution digital files you can edit, share, and store.<\/p><ul><li>Submit only <strong>developed film<\/strong>, no processing required.<br\/><\/li><li>Receive professionally scanned files with color-managed workflow, ready for print, web, or editing.<br\/><\/li><li>Perfect for photographers who <em>just want premium scanning<\/em> without the development step.<br\/><\/li><li>Not intended for long-term family-archive rescues, that’s what our Archival Box service is for.<\/li><\/ul>","text_style":"body"}},"button_NCr8dg":{"type":"button","settings":{"button_label":"scan only","button_link":"shopify:\/\/collections\/scan-only","button_style_secondary":false}}},"block_order":["heading_JMKjj7","text_CKHTCn","button_NCr8dg"],"name":"t:sections.image-with-text.presets.name","settings":{"image":"shopify:\/\/shop_images\/Uncut_35mm_Film_Archival_Asset_6e205f0e-e17d-4dd5-b9f4-0fdc2e590c99.jpg","height":"adapt","desktop_image_width":"medium","layout":"image_first","desktop_content_position":"top","desktop_content_alignment":"left","content_layout":"no-overlap","section_color_scheme":"","color_scheme":"","image_behavior":"none","mobile_content_alignment":"left","padding_top":36,"padding_bottom":36}},"rich_text_ARdVMj":{"type":"rich-text","blocks":{"heading_6EYAqn":{"type":"heading","settings":{"heading":"Looking For a Little More?","heading_size":"h1"}},"text_Dc6k7R":{"type":"text","settings":{"text":"<p>Our premium service is for discerning photographers who want to have the <strong>highest quality film scans with the least amount post editing work. <\/strong>Premium is the best option if you are a busy creative who wants to <strong>spend less time in front of a computer and more time taking photos.<\/strong><br\/><br\/>Discerning premium customers may also book a personalized color consultation appointment to dial in their exact color preferences, so each order you send closely matches your preferred style.<\/p>"}},"button_igRrd9":{"type":"button","settings":{"button_label":"Premium Processing","button_link":"shopify:\/\/pages\/premium-processing","button_style_secondary":false,"button_label_2":"","button_link_2":"","button_style_secondary_2":false}}},"block_order":["heading_6EYAqn","text_Dc6k7R","button_igRrd9"],"settings":{"desktop_content_position":"center","content_alignment":"center","color_scheme":"","full_width":true,"padding_top":40,"padding_bottom":52}},"collapsible_content_3WkQf7":{"type":"collapsible-content","blocks":{"collapsible_row_rxyfWH":{"type":"collapsible_row","settings":{"heading":"What service do I need?","icon":"question_mark","row_content":"<ul><li><strong>Develop & Scan <\/strong>Whether you’re a seasoned photographer or a casual shooter, this service delivers carefully processed film with high-quality, color-corrected scans. <\/li><li><strong>Develop Only: <\/strong>if you don't want to deal with the stinky process of developing your film and are one of the lucky few to have a scanner at home. Our Develop Only service is what you need.<\/li><\/ul>","page":""}},"collapsible_row_DCWXHD":{"type":"collapsible_row","settings":{"heading":"What are negatives?","icon":"question_mark","row_content":"<p>Contrary to popular belief, negatives are not your <strong>bad <\/strong>pictures. They are the actual roll of film after development. Keep them for archival purposes and or troubleshooting camera issues.<\/p>","page":""}},"collapsible_row_QLDUaN":{"type":"collapsible_row","disabled":true,"settings":{"heading":"What About Physical Prints?","icon":"question_mark","row_content":"<p>In order to get physical prints out of your roll of film, we must have the digital files. <\/p>","page":""}},"collapsible_row_pAUKY8":{"type":"collapsible_row","settings":{"heading":"How do I know which processing type to select?","icon":"question_mark","row_content":"<p>The film canister displays processing type in small font: C-41, Black and White, ECN-2, or E-6.<\/p>","page":""}},"collapsible_row_RRD3Rp":{"type":"collapsible_row","settings":{"heading":"How do I get my film to you?","icon":"question_mark","row_content":"<ul><li>If residing in the Tampa Bay Area, feel free to drop off your film at our Tampa location in person or through the drop box located in the back parking lot.<\/li><li>When mailing your film, make use of a box or bubble mailer (envelopes should be avoided) and send it to: 1704 N Nebraska Ave Tampa, FL 33602<\/li><li>Ensure to include your name and order number with your film.<\/li><\/ul>","page":""}},"collapsible_row_HNk39K":{"type":"collapsible_row","settings":{"heading":"How do you deliver my photos?","icon":"question_mark","row_content":"<p>We will upload your pictures to Google Drive and provide you with a link via email to an order folder containing your film rolls.<br\/><\/p><p>Download your photos in a timely manner as we will remove them from Google Drive after 6 months.<\/p>","page":""}},"collapsible_row_dF6PVb":{"type":"collapsible_row","settings":{"heading":"How long will you keep my negatives?","icon":"question_mark","row_content":"<p>You have 6 weeks to collect your negatives from our store. To request mail delivery, contact admin@coastalfilmlab.com.<\/p>","page":""}}},"block_order":["collapsible_row_rxyfWH","collapsible_row_DCWXHD","collapsible_row_QLDUaN","collapsible_row_pAUKY8","collapsible_row_RRD3Rp","collapsible_row_HNk39K","collapsible_row_dF6PVb"],"settings":{"caption":"","heading":"Frequently Asked Questions","heading_size":"h1","heading_alignment":"left","layout":"row","color_scheme":"","container_color_scheme":"","open_first_collapsible_row":false,"image":"shopify:\/\/shop_images\/DEONH-032-WebSize008.jpg","image_ratio":"adapt","desktop_layout":"image_second","padding_top":36,"padding_bottom":36}},"1736288092f8ba9d3f":{"type":"apps","blocks":{"judge_me_reviews_review_widget_homepage_njxJxH":{"type":"shopify:\/\/apps\/judge-me-reviews\/blocks\/review_widget_homepage\/61ccd3b1-a9f2-4160-9fe9-4fec8413e5d8","settings":{"product":"develop-and-scan-35mm-c41","review_data":"sample_data","max_width":1200}}},"block_order":["judge_me_reviews_review_widget_homepage_njxJxH"],"disabled":true,"settings":{"include_margins":true}}},"order":["main","image_banner_FVNpH9","rich_text_jD4mRm","custom_liquid_UDC7GB","custom_liquid_GzAWMJ","image_with_text_LXYHRr","image_with_text_za6MBJ","image_with_text_YxtnnM","rich_text_ARdVMj","collapsible_content_3WkQf7","1736288092f8ba9d3f"]}