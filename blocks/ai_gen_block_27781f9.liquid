{% doc %}
  @prompt
    Create a grid that displays cards. from top to bottom, the card should contain a product photo section, information section, a quantity selector, and finally an add to cart.
    
    in the information section, it should have two collumns. the col on the left should be the product title. and the col on the right should be a definition I'll be adding in.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    padding: {{ block.settings.section_padding }}px;
    max-width: 1800px;
    margin: 0 auto;
  }

  @media screen and (max-width: 1400px) {
    .ai-product-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media screen and (max-width: 1100px) {
    .ai-product-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media screen and (max-width: 749px) {
    .ai-product-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }
  }

  .ai-product-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    max-width: 350px;
  }

  .ai-product-image-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.image_ratio }};
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-product-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-product-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-product-info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    padding: {{ block.settings.card_padding }}px;
    border-bottom: 1px solid {{ block.settings.divider_color }};
    gap: 8px;
  }

  .ai-product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.3;
    text-align: center;
    width: 100%;
  }

  .ai-product-definition-{{ ai_gen_id }} {
    font-size: {{ block.settings.definition_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.4;
    text-align: center;
    width: 100%;
  }

  .ai-quantity-selector-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: {{ block.settings.card_padding }}px;
    border-bottom: 1px solid {{ block.settings.divider_color }};
  }

  .ai-quantity-button-{{ ai_gen_id }} {
    width: 36px;
    height: 36px;
    border: 1px solid {{ block.settings.button_border_color }};
    background-color: {{ block.settings.quantity_button_bg }};
    color: {{ block.settings.text_color }};
    border-radius: 4px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    transition: background-color 0.2s ease;
  }

  .ai-quantity-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.quantity_button_hover_bg }};
  }

  .ai-quantity-button-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-quantity-input-{{ ai_gen_id }} {
    width: 50px;
    height: 36px;
    text-align: center;
    border: 1px solid {{ block.settings.button_border_color }};
    border-radius: 4px;
    font-size: 16px;
    color: {{ block.settings.text_color }};
    padding: 0;
    -moz-appearance: textfield;
  }

  .ai-quantity-input-{{ ai_gen_id }}::-webkit-inner-spin-button,
  .ai-quantity-input-{{ ai_gen_id }}::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .ai-add-to-cart-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
  }

  .ai-add-to-cart-button-{{ ai_gen_id }} {
    width: 100%;
    padding: 14px 24px;
    background-color: {{ block.settings.button_bg }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .ai-add-to-cart-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg }};
  }

  .ai-add-to-cart-button-{{ ai_gen_id }}:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .ai-empty-state-{{ ai_gen_id }} {
    grid-column: 1 / -1;
    text-align: center;
    padding: 60px 20px;
    color: #666;
    font-size: 16px;
  }
{% endstyle %}

<product-grid-{{ ai_gen_id }} class="ai-product-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.products.count > 0 %}
    {% for product in block.settings.products %}
      <div class="ai-product-card-{{ ai_gen_id }}" data-product-id="{{ product.id }}">
        <div class="ai-product-image-{{ ai_gen_id }}">
          {% if product.featured_image %}
            <img
              src="{{ product.featured_image | image_url: width: 600 }}"
              alt="{{ product.featured_image.alt | escape }}"
              loading="lazy"
              width="600"
              height="600"
            >
          {% else %}
            <div class="ai-product-image-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>

        <div class="ai-product-info-{{ ai_gen_id }}">
          <h3 class="ai-product-title-{{ ai_gen_id }}">{{ product.title }}</h3>
          <div class="ai-product-definition-{{ ai_gen_id }}">
            {% assign definition_key = 'product_' | append: forloop.index | append: '_definition' %}
            {{ block.settings[definition_key] }}
          </div>
        </div>

        <div class="ai-quantity-selector-{{ ai_gen_id }}">
          <button
            type="button"
            class="ai-quantity-button-{{ ai_gen_id }}"
            data-action="decrease"
            aria-label="Decrease quantity"
          >
            −
          </button>
          <input
            type="number"
            class="ai-quantity-input-{{ ai_gen_id }}"
            value="1"
            min="1"
            max="9999"
            aria-label="Quantity"
          >
          <button
            type="button"
            class="ai-quantity-button-{{ ai_gen_id }}"
            data-action="increase"
            aria-label="Increase quantity"
          >
            +
          </button>
        </div>

        <div class="ai-add-to-cart-{{ ai_gen_id }}">
          <button
            type="button"
            class="ai-add-to-cart-button-{{ ai_gen_id }}"
            data-product-id="{{ product.id }}"
            data-variant-id="{{ product.selected_or_first_available_variant.id }}"
          >
            {{ block.settings.button_text }}
          </button>
        </div>
      </div>
    {% endfor %}
  {% else %}
    <div class="ai-empty-state-{{ ai_gen_id }}">
      Next, add products to display in the grid
    </div>
  {% endif %}
</product-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupQuantitySelectors();
        this.setupAddToCart();
      }

      setupQuantitySelectors() {
        const cards = this.querySelectorAll('.ai-product-card-{{ ai_gen_id }}');
        
        cards.forEach((card) => {
          const decreaseBtn = card.querySelector('[data-action="decrease"]');
          const increaseBtn = card.querySelector('[data-action="increase"]');
          const input = card.querySelector('.ai-quantity-input-{{ ai_gen_id }}');

          decreaseBtn.addEventListener('click', () => {
            const currentValue = parseInt(input.value);
            if (currentValue > 1) {
              input.value = currentValue - 1;
            }
          });

          increaseBtn.addEventListener('click', () => {
            const currentValue = parseInt(input.value);
            if (currentValue < 9999) {
              input.value = currentValue + 1;
            }
          });

          input.addEventListener('change', () => {
            let value = parseInt(input.value);
            if (isNaN(value) || value < 1) {
              input.value = 1;
            } else if (value > 9999) {
              input.value = 9999;
            }
          });
        });
      }

      setupAddToCart() {
        const buttons = this.querySelectorAll('.ai-add-to-cart-button-{{ ai_gen_id }}');
        
        buttons.forEach((button) => {
          button.addEventListener('click', async () => {
            const card = button.closest('.ai-product-card-{{ ai_gen_id }}');
            const quantityInput = card.querySelector('.ai-quantity-input-{{ ai_gen_id }}');
            const quantity = parseInt(quantityInput.value);
            const variantId = button.dataset.variantId;

            button.disabled = true;
            const originalText = button.textContent;
            button.textContent = 'Adding...';

            try {
              const response = await fetch('/cart/add.js', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                  items: [{
                    id: variantId,
                    quantity: quantity
                  }]
                })
              });

              if (response.ok) {
                button.textContent = 'Added!';
                setTimeout(() => {
                  button.textContent = originalText;
                  button.disabled = false;
                }, 2000);

                window.dispatchEvent(new Event('cart:updated'));
              } else {
                throw new Error('Failed to add to cart');
              }
            } catch (error) {
              button.textContent = 'Error';
              setTimeout(() => {
                button.textContent = originalText;
                button.disabled = false;
              }, 2000);
            }
          });
        });
      }
    }

    customElements.define('product-grid-{{ ai_gen_id }}', ProductGrid{{ ai_gen_id }});
  })();
</script>

